20.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 jardów</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Arkusz papieru około 1 × 1 m albo tarcza do sprawdzania rozrzutu</li><li><b aria-hidden=\"true\">2</b>Koło o średnicy 75–76 cm wokół najgęstszej części</li><li><b aria-hidden=\"true\">3</b>Policz przestrzeliny w środku i porównaj z liczbą śrucin w naboju (28 g nr 7½: około 350–400)</li><li><b aria-hidden=\"true\">4</b>Do oceny czoka: 35 m lub 40 jardów (do dopasowania broni: około 15 m)</li><li><b aria-hidden=\"true\">5</b>Mniej więcej taka część śrutu trafia w koło</li></ol><figcaption>Procenty są przybliżone i zależą od naboju. Oddaj co najmniej 3–5 strzałów na każde połączenie czoka i naboju.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"Orientacyjnie na tej odległości <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (walec)</a> kładzie w okręgu około 40% śrutu, improved cylinder około 50%, modified około 60%, improved modified około 65%, a full 70% i więcej. Te liczby zależą od naboju, więc twoja para broń + nabój może dać inny wynik.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Jeden strzał mało udowadnia: rozrzuty zauważalnie różnią się nawet z identycznymi nabojami. Oddaj co najmniej 3–5 strzałów na każdą kombinację. Patrz też na równomierność: dobry rozrzut jest równy, bez dużych dziur i bez gęstej plamy w środku.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Po strzelaniu wykręć czoki <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/choke-key/\"><span lang=\"en\">choke key</span> (kluczem do czoków)</a>.","Wyczyść je wewnątrz i zewnątrz płynem do czyszczenia i szczotką, i przetrzyj gwint w wylocie lufy.","Zanim je wkręcisz z powrotem, nałóż na gwint cienką warstwę <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (smaru do czoków)</a>: chroni on przed rdzą i nie dopuszcza, by czok się zapiekł."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Przed każdymi zajęciami sprawdzaj, czy czoki są dokręcone: strzelanie może je z czasem poluzować. Dokręcaj je kluczem do oporu, ale bez nadmiernej siły.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Nigdy nie strzelaj z broni z <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (czokami wymiennymi)</a> bez czoka albo z czokiem wkręconym tylko do połowy. Śrut i <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/wad/\"><span lang=\"en\">wad</span> (przybitka)</a> mogą uszkodzić gwint w wylocie lufy, a naprawa jest kosztowna. Przechowuj zapasowe czoki w osobnym pudełku, by ich nie zgubić.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"Rozrzut sprawdza się na tarczy: dopasowanie z około 15 m (16 jardów), czoki z 35 m albo 40 jardów.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Licz udział śrutu w okręgu 75–76 cm; oddaj 3–5 strzałów.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Czyść czoki po strzelaniu i smaruj gwinty smarem do czoków.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Przed każdymi zajęciami sprawdzaj, czy czoki są dokręcone.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Unikaj strzelania z broni z czokami wymiennymi bez czoka.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Po każdym strzale tarczę do sprawdzania rozrzutu maluje się albo smaruje ponownie, wałkiem albo szczotką, by nowe ślady nie zmieszały się z poprzednimi."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Czemu nie wolno strzelać z broni z multichoke (czokami wymiennymi) bez czoka?","options":[{"k":"a","text":"Jest to zakazane tylko na zawodach"},{"k":"b","text":"Śrut i przybitka mogą uszkodzić gwint w wylocie lufy"},{"k":"c","text":"Broń wtedy wcale nie wystrzeli"},{"k":"d","text":"Rozrzut staje się dużo za wąski"}],"correct":"b","explain":"Bez czoka gwint jest odkryty, i śrut z przybitką mogą go uszkodzić."},{"k":"chokes-pattern-testing-and-care-q2","q":"Na jakiej klasycznej odległości ocenia się rozrzut czoka?","options":[{"k":"a","text":"5 m (około 5½ jarda)"},{"k":"b","text":"15 m (około 16 jardów)"},{"k":"c","text":"35 m albo 40 jardów (około 37 m)"},{"k":"d","text":"80 m (około 87 jardów)"}],"correct":"c","explain":"Udział śrutu w okręgu 75–76 cm klasycznie liczy się na 35 m albo 40 jardach."},{"k":"chokes-pattern-testing-and-care-q3","q":"Ile strzałów warto oddać, by ocenić rozrzut?","options":[{"k":"a","text":"Co najmniej 3–5 na każdą parę"},{"k":"b","text":"Jeden strzał w tym wystarczy"},{"k":"c","text":"Dokładnie dwa, jeden na lufę"},{"k":"d","text":"Sto, tego samego dnia"}],"correct":"a","explain":"Rozrzuty różnią się od strzału do strzału, więc dla każdej pary broń + czok + nabój potrzebna jest seria."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"tarcza do sprawdzania rozrzutu","label":"Pattern plate (tarcza do sprawdzania rozrzutu)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"rozrzut śrutu","label":"Pattern (rozrzut śrutu)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/pattern/"},{"id":"choke","en":"Choke","local":"czok","label":"Choke (czok)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"czoki wymienne","label":"Multichoke (czoki wymienne)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"klucz do czoków","label":"Choke key (klucz do czoków)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"smar do czoków","label":"Choke grease (smar do czoków)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"dopasowanie strzelby","label":"Gun fit (dopasowanie strzelby)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"przybitka","label":"Wad (przybitka)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"walec","label":"Cylinder (walec)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"ćwierćczok","label":"Improved cylinder (ćwierćczok)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"półczok","label":"Modified (półczok)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"czok 3/4","label":"Improved modified (czok 3/4)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"pełny czok","label":"Full choke (pełny czok)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
