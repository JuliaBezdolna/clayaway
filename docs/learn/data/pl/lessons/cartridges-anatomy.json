\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">wystrzelona łuska: zwykle 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Łuska (plastikowa lub papierowa)</li><li><b aria-hidden=\"true\">2</b>Metalowe denko</li><li><b aria-hidden=\"true\">3</b>Spłonka</li><li><b aria-hidden=\"true\">4</b>Proch</li><li><b aria-hidden=\"true\">5</b>Przybitka</li><li><b aria-hidden=\"true\">6</b>Śrut</li><li><b aria-hidden=\"true\">7</b>Zawijka (gwiazdka z 6 lub 8 zagięć)</li></ol><figcaption>Co jest w jednym naboju, od metalowego denka po zawijkę.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"Łuska to rurka, najczęściej plastikowa, z metalowym denkiem na dole. Są też łuski papierowe: niektóre strzelnice je preferują, bo mniej zaśmiecają przyrodę. Wystrzelona łuska ma zwykle 65–70 mm długości i musi odpowiadać <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/chamber/\"><span lang=\"en\">chamber</span> (komorze)</a> twojej broni (zob. <a href=\"https://juliabezdolna.github.io/clayaway/pl/learn/gun-gauge-and-barrels/\">Kaliber i długość lufy</a>).","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"W środku denka jest spłonka. Gdy uderzy w nią iglica, spłonka daje iskrę i zapala proch. Proch nie wybucha, a bardzo szybko się spala, a gazy pchają ładunek śrutu przez lufę.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"Między prochem a śrutem jest przybitka. Działa jak zatyczka: nie przepuszcza gorących gazów obok śrucin, łagodzi pchnięcie i utrzymuje śruciny razem, gdy przechodzą przez lufę. Przybitka plastikowa ma zwykle kubeczek, który chroni śruciny i często daje trochę węższy rozrzut.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/fibre-wad/\"><span lang=\"en\">Fibre wad</span> (przybitka filcowa albo z włókna)</a> rozkłada się w przyrodzie, więc wiele strzelnic jej wymaga. Istnieją też biodegradowalne przybitki plastikowe, ale nie wszystkie strzelnice je przyjmują.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"Nad przybitką jest śrut: kilkaset małych śrucin. Górę łuski zamyka <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/crimp/\"><span lang=\"en\">crimp</span> (zawijka)</a>, najczęściej „gwiazdka” z 6 albo 8 zagięć. Dobra zawijka mocno utrzymuje wszystko na miejscu i pomaga, by każdy nabój strzelał tak samo jak poprzedni.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"Przepisy FITASC dla Parcours de Chasse – Sporting™ i Compak® Sporting zakazują <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/reloaded-cartridge/\"><span lang=\"en\">reloaded cartridges</span> (nabojów elaborowanych)</a>, czyli wystrzelonych łusek napełnionych ponownie, na przykład w domu. Zakazane są też rozpraszacze, czyli wkładki, które celowo rozszerzają <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/pattern/\"><span lang=\"en\">pattern</span> (rozrzut śrutu)</a>, i wszelkie inne specjalne urządzenia wewnątrz naboju. Zakazana jest też mieszanka śrutu różnych rozmiarów albo jakości, proch czarny i naboje smugowe (zostawiające jaśniejący ślad). Na zawody zabieraj więc naboje fabryczne, zgodne z przepisami.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"Na pudełku zwykle widać <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/gauge/\"><span lang=\"en\">gauge</span> (kaliber)</a>, długość łuski, naważkę, numer albo <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/shot-size/\"><span lang=\"en\">shot size</span> (średnicę śrutu)</a>, materiał śrutu i typ przybitki, a często też prędkość. Nauczysz się czytać pudełko — i będziesz wiedzieć, czym nabijasz broń.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Niektóre strzelnice dodają własne przepisy środowiskowe na treningi, na przykład tylko przybitki filcowe albo tylko <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (śrut stalowy)</a>: sprawdź regulamin strzelnicy przed wyjazdem. Puste łuski wkłada się do pojemnika na stanowisku, a strzelcy z <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pl/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span> (półautomatami)</a> zbierają swoje wyrzucone łuski, gdy schodzą ze stanowiska.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"Trzy liczby z pudełka mają swoje osobne lekcje: kaliber (<a href=\"https://juliabezdolna.github.io/clayaway/pl/learn/gun-gauge-and-barrels/\">Kaliber i długość lufy</a>), numer śrutu (<a href=\"https://juliabezdolna.github.io/clayaway/pl/learn/cartridges-shot-size/\">Numer śrutu</a>) i naważkę (<a href=\"https://juliabezdolna.github.io/clayaway/pl/learn/cartridges-load-weight/\">Naważka śrutu</a>).","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Wrzucaj wystrzelone łuski do pojemnika.","say":"Puste łuski do pojemnika, proszę, nie na trawę.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Lead shot (śrut ołowiany) jest na tej strzelnicy niedozwolony (przepis lokalny, nie FITASC).","say":"Na tej strzelnicy tylko stal.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Nabój = łuska, spłonka, proch, przybitka, śrut.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Przybitka plastikowa: często trochę węższy rozrzut; przybitka filcowa: rozkłada się w przyrodzie.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"FITASC zakazuje naboi elaborowanych, rozpraszaczy, mieszanki śrutu, prochu czarnego i naboi smugowych.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Czytaj pudełko: kaliber, długość, naważka, śrut, przybitka.","checklist":false},{"k":"gear-cartridges-kp5","html":"Puste łuski do pojemnika; użytkownicy półautomatów zbierają swoje łuski.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Po strzale przybitka plastikowa leci jeszcze kilkadziesiąt metrów za stanowisko. Dlatego na polach wokół starych strzelnic bywają pełne przybitek, podczas gdy filc stopniowo się rozkłada."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Co zapala powder (proch) w naboju?","options":[{"k":"a","text":"Przybitka"},{"k":"b","text":"Spłonka"},{"k":"c","text":"Zawijka"},{"k":"d","text":"Śrut"}],"correct":"b","explain":"Iglica uderza w spłonkę, a ta zapala proch."},{"k":"cartridges-anatomy-q2","q":"Czemu wiele strzelnic wymaga przybitek filcowych?","options":[{"k":"a","text":"Są tańsze"},{"k":"b","text":"Dają węższy rozrzut"},{"k":"c","text":"Rozkładają się w przyrodzie"},{"k":"d","text":"Wymaga tego FITASC"}],"correct":"c","explain":"Filc i włókno rozkładają się, a zwykłe wad (przybitki) plastikowe zostają na polach latami."},{"k":"cartridges-anatomy-q3","q":"Jakie cartridge (naboje) zakazują przepisy FITASC?","options":[{"k":"a","text":"Fabryczne z przybitką plastikową"},{"k":"b","text":"Fabryczne z przybitką filcową"},{"k":"c","text":"Naboje z łuską papierową"},{"k":"d","text":"Naboje elaborowane"}],"correct":"d","explain":"Zakazane są naboje elaborowane, rozpraszacze, mieszanka śrutu, proch czarny i naboje smugowe.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"nabój","label":"Cartridge (nabój)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"łuska","label":"Hull (łuska)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/hull/"},{"id":"primer","en":"Primer","local":"spłonka","label":"Primer (spłonka)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/primer/"},{"id":"powder","en":"Powder","local":"proch","label":"Powder (proch)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/powder/"},{"id":"wad","en":"Wad","local":"przybitka","label":"Wad (przybitka)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"przybitka filcowa","label":"Fibre wad (przybitka filcowa)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"zawijka","label":"Crimp (zawijka)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"komora nabojowa","label":"Chamber (komora nabojowa)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"puste łuski","label":"Empty cases (puste łuski)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"półautomat","label":"Semi-automatic (półautomat)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"śrut stalowy","label":"Steel shot (śrut stalowy)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"numer śrutu","label":"Shot size (numer śrutu)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"naważka śrutu","label":"Load weight (naważka śrutu)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"kaliber","label":"Gauge (kaliber)","url":"https://juliabezdolna.github.io/clayaway/pl/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Rozdział 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=pl#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Rozdział 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=pl#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Rozdział 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=pl#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Rozdział 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=pl#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
