=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"116\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"135.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">bossolo sparato: di solito 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Bossolo (plastica o carta)</li><li><b aria-hidden=\"true\">2</b>Fondello metallico</li><li><b aria-hidden=\"true\">3</b>Innesco</li><li><b aria-hidden=\"true\">4</b>Polvere</li><li><b aria-hidden=\"true\">5</b>Borra</li><li><b aria-hidden=\"true\">6</b>Pallini</li><li><b aria-hidden=\"true\">7</b>Chiusura stellare (6 o 8 pieghe)</li></ol><figcaption>Che cosa c’è dentro una cartuccia, dal fondello metallico alla chiusura.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"Il bossolo è un tubo, più spesso di plastica, con una testa metallica in fondo. Esistono anche bossoli di carta, e alcuni campi li preferiscono perché lasciano meno rifiuti. Un bossolo sparato è di solito lungo 65–70 mm, e deve adattarsi alla <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/chamber/\"><span lang=\"en\">chamber</span> (camera di scoppio)</a> del tuo fucile (vedi <a href=\"https://juliabezdolna.github.io/clayaway/it/learn/gun-gauge-and-barrels/\">Calibro e lunghezza delle canne</a>).","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"Al centro della testa sta l'innesco. Quando il percussore lo colpisce, l'innesco dà una scintilla e accende la polvere. La polvere non esplode ma brucia molto in fretta, e i gas spingono la carica di piombini lungo la canna.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"Tra la polvere e i pallini sta la borra. Funziona come un tappo: impedisce al gas caldo di passare oltre i pallini, attutisce la spinta e tiene i pallini insieme mentre viaggiano lungo la canna. Una borra di plastica ha di solito una coppetta che protegge i pallini e spesso dà una <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/pattern/\"><span lang=\"en\">pattern</span> (rosata)</a> un po' più stretta.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"Una <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/fibre-wad/\"><span lang=\"en\">fibre wad</span> (borra in fibra o feltro)</a> si decompone in natura, quindi molti campi la richiedono. Esistono anche borre di plastica biodegradabili, ma alcuni campi non le accettano.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"Sopra la borra ci sono i pallini: diverse centinaia di piccole sfere. La parte superiore del bossolo è chiusa dalla <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/crimp/\"><span lang=\"en\">crimp</span> (chiusura stellare)</a>, più spesso una stella a 6 o 8 pieghe. Una buona chiusura tiene tutto saldamente in posizione e aiuta ogni cartuccia a sparare come la precedente.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"Il regolamento FITASC di Parcours de Chasse – Sporting™ e Compak® Sporting vieta le cartucce ricaricate, cioè bossoli sparati riempiti di nuovo, per esempio in casa. Vieta anche i dispersori (inserti che allargano apposta i pallini) e qualsiasi altro dispositivo speciale dentro la cartuccia. Sono vietati anche pallini misti di misure o qualità diverse, la polvere nera e le traccianti (cartucce che lasciano una scia luminosa). Quindi per le gare porta cartucce di fabbrica conformi al regolamento.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"La scatola indica di solito il <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/gauge/\"><span lang=\"en\">gauge</span> (calibro)</a>, la lunghezza del bossolo, la carica, il numero o il diametro dei pallini, il materiale dei pallini e il tipo di borra, e spesso la velocità. Imparare a leggere la scatola ti farà sapere cosa stai caricando.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Alcuni campi aggiungono proprie regole ambientali per l'allenamento, per esempio solo borre in fibra o solo <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (pallini d'acciaio)</a>: controlla le regole del campo prima di un viaggio. I bossoli vuoti vanno nel contenitore in pedana, e i tiratori con <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/it/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span></a> raccolgono i bossoli espulsi quando se ne vanno.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"Tre numeri della scatola hanno lezioni proprie: il calibro (<a href=\"https://juliabezdolna.github.io/clayaway/it/learn/gun-gauge-and-barrels/\">Calibro e lunghezza delle canne</a>), il numero dei pallini (<a href=\"https://juliabezdolna.github.io/clayaway/it/learn/cartridges-shot-size/\">Il numero del pallino</a>) e la carica (<a href=\"https://juliabezdolna.github.io/clayaway/it/learn/cartridges-load-weight/\">La grammatura</a>).","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Metti i bossoli sparati nel contenitore.","say":"I bossoli nel contenitore, per favore, non sull'erba.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Su questo campo i lead shot (pallini di piombo) non sono ammessi (una regola locale, non della FITASC).","say":"Su questo campo solo acciaio.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Cartuccia = bossolo, innesco, polvere, borra, pallini.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Borra di plastica: spesso una rosata un po' più stretta; borra in fibra: si decompone in natura.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"La FITASC vieta cartucce ricaricate, dispersori, pallini misti, polvere nera e traccianti.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Leggi la scatola: calibro, lunghezza, carica, pallini, borra.","checklist":false},{"k":"gear-cartridges-kp5","html":"I bossoli vuoti nel contenitore; chi usa il semiautomatico raccoglie i propri bossoli.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Dopo il colpo, una borra di plastica continua a volare per diverse decine di metri oltre la pedana. Per questo i campi vicino ai vecchi tiri possono essere pieni di borre, mentre la fibra si decompone poco a poco."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Cosa accende la powder (polvere) in una cartridge (cartuccia)?","options":[{"k":"a","text":"La borra"},{"k":"b","text":"L'innesco"},{"k":"c","text":"La chiusura"},{"k":"d","text":"I pallini"}],"correct":"b","explain":"Il percussore colpisce l'innesco, che accende la polvere."},{"k":"cartridges-anatomy-q2","q":"Perché molti campi richiedono fibre wad (borre in fibra)?","options":[{"k":"a","text":"Sono più economiche"},{"k":"b","text":"Danno una rosata più stretta"},{"k":"c","text":"Si decompongono in natura"},{"k":"d","text":"Lo richiede la FITASC"}],"correct":"c","explain":"Fibra e feltro si decompongono, mentre le normali borre di plastica restano nei campi per anni."},{"k":"cartridges-anatomy-q3","q":"Quali cartucce vieta il regolamento FITASC?","options":[{"k":"a","text":"Cartucce di fabbrica con borra di plastica"},{"k":"b","text":"Cartucce di fabbrica con borra in fibra"},{"k":"c","text":"Cartucce con bossolo di carta"},{"k":"d","text":"Cartucce ricaricate"}],"correct":"d","explain":"Sono vietate le cartucce ricaricate, i dispersori, i pallini misti, la powder (polvere) nera e le traccianti.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"cartuccia","label":"Cartridge (cartuccia)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"bossolo","label":"Hull (bossolo)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/hull/"},{"id":"primer","en":"Primer","local":"innesco","label":"Primer (innesco)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/primer/"},{"id":"powder","en":"Powder","local":"polvere","label":"Powder (polvere)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/powder/"},{"id":"wad","en":"Wad","local":"borra","label":"Wad (borra)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"borra in feltro","label":"Fibre wad (borra in feltro)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"chiusura","label":"Crimp (chiusura)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"camera di scoppio","label":"Chamber (camera di scoppio)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"bossoli","label":"Empty cases (bossoli)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"","label":"Semi-automatic","url":"https://juliabezdolna.github.io/clayaway/it/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"pallini d'acciaio","label":"Steel shot (pallini d'acciaio)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"numero del pallino","label":"Shot size (numero del pallino)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"grammatura","label":"Load weight (grammatura)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"calibro","label":"Gauge (calibro)","url":"https://juliabezdolna.github.io/clayaway/it/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Capitolo 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=it#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Capitolo 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=it#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Capitolo 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=it#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Capitolo 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=it#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
