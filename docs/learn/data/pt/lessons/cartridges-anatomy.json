=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">invólucro disparado: em geral 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Invólucro (plástico ou papel)</li><li><b aria-hidden=\"true\">2</b>Base metálica</li><li><b aria-hidden=\"true\">3</b>Fulminante</li><li><b aria-hidden=\"true\">4</b>Pólvora</li><li><b aria-hidden=\"true\">5</b>Bucha</li><li><b aria-hidden=\"true\">6</b>Chumbo</li><li><b aria-hidden=\"true\">7</b>Fecho em estrela (6 ou 8 dobras)</li></ol><figcaption>O que há dentro de um cartucho, da base metálica ao fecho em estrela.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Alguns campos acrescentam as suas próprias regras ambientais para os treinos, por exemplo só <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/fibre-wad/\"><span lang=\"en\">fibre wads</span> (buchas de feltro)</a> ou só <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (chumbo de aço)</a>: verifique as regras do campo antes da viagem. Os <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/empties/\"><span lang=\"en\">empty cases</span> (invólucros vazios)</a> vão para o recipiente do posto, e os atiradores com semi-automáticas apanham os seus invólucros ejetados quando saem.","disc":"both","rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Ponha os invólucros disparados no recipiente.","say":"Os vazios no recipiente, por favor, não na relva.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Neste campo não são permitidos cartuchos com chumbo (é uma regra local, não da FITASC).","say":"Neste campo, só chumbo de aço.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Cartucho = invólucro, fulminante, pólvora, bucha, chumbo.","checklist":false},{"k":"gear-cartridges-kp5","html":"Os vazios vão para o recipiente; quem usa <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span></a> apanha os seus invólucros.","checklist":false}],"did_you_know":null,"quiz":[{"k":"cartridges-anatomy-q1","q":"O que inflama a powder (pólvora) num cartridge (cartucho)?","options":[{"k":"a","text":"A bucha"},{"k":"b","text":"O fulminante"},{"k":"c","text":"O fecho em estrela"},{"k":"d","text":"O chumbo"}],"correct":"b","explain":"O percutor bate no fulminante, e o fulminante inflama a pólvora."},{"k":"cartridges-anatomy-q2","q":"Porque é que muitos campos exigem fibre wads (buchas de fibra)?","options":[{"k":"a","text":"São mais baratas"},{"k":"b","text":"Dão uma chumbada mais apertada"},{"k":"c","text":"Decompõem-se na natureza"},{"k":"d","text":"A FITASC exige-o"}],"correct":"c","explain":"A fibra e o feltro decompõem-se, enquanto as buchas de plástico comuns ficam anos nos campos."},{"k":"cartridges-anatomy-q3","q":"Que cartridges (cartuchos) são proibidos pelas regras da FITASC?","options":[{"k":"a","text":"Cartuchos de fábrica com wad de plástico"},{"k":"b","text":"Cartuchos de fábrica com fibre wad"},{"k":"c","text":"Cartuchos com hull de papel"},{"k":"d","text":"Reloaded cartridges"}],"correct":"d","explain":"Os cartuchos recarregados, os dispersores, a mistura de números de chumbo, a powder (pólvora) negra e os traçadores são proibidos.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"cartucho","label":"Cartridge (cartucho)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"invólucro","label":"Hull (invólucro)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/hull/"},{"id":"primer","en":"Primer","local":"fulminante","label":"Primer (fulminante)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/primer/"},{"id":"powder","en":"Powder","local":"pólvora","label":"Powder (pólvora)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/powder/"},{"id":"wad","en":"Wad","local":"bucha","label":"Wad (bucha)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"bucha de feltro","label":"Fibre wad (bucha de feltro)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"fecho em estrela","label":"Crimp (fecho em estrela)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"câmara","label":"Chamber (câmara)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"cartuchos vazios","label":"Empty cases (cartuchos vazios)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"","label":"Semi-automatic","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"chumbo de aço","label":"Steel shot (chumbo de aço)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"número do chumbo","label":"Shot size (número do chumbo)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"carga","label":"Load weight (carga)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"calibre","label":"Gauge (calibre)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Capítulo 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=pt#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Capítulo 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=pt#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Capítulo 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=pt#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Capítulo 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=pt#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":12}
