cx=\"309.7\" cy=\"205.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"246.3\" cy=\"123.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"381.0\" cy=\"151.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"237.6\" cy=\"228.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"299.0\" cy=\"126.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"339.0\" cy=\"198.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"227.4\" cy=\"155.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"367.8\" cy=\"107.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"297.2\" cy=\"178.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"275.0\" cy=\"124.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"361.4\" cy=\"174.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"231.1\" cy=\"196.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.5\" cy=\"76.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"312.6\" cy=\"187.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"251.7\" cy=\"140.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"366.0\" cy=\"138.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"259.6\" cy=\"230.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"297.1\" cy=\"149.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"333.9\" cy=\"181.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"240.8\" cy=\"168.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"347.4\" cy=\"103.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"306.2\" cy=\"245.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"281.2\" cy=\"143.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"349.0\" cy=\"160.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"249.9\" cy=\"201.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"308.7\" cy=\"82.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"356.7\" cy=\"233.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"264.3\" cy=\"153.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"348.3\" cy=\"132.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"279.7\" cy=\"226.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"261.1\" cy=\"85.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"318.8\" cy=\"166.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"257.9\" cy=\"175.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"328.1\" cy=\"105.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"322.3\" cy=\"232.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"220.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 jardas</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Uma folha de papel com cerca de 1 × 1 m, ou uma placa de chumbada</li><li><b aria-hidden=\"true\">2</b>Um círculo de 75–76 cm de diâmetro à volta da parte mais densa</li><li><b aria-hidden=\"true\">3</b>Conte os furos dentro e compare com os bagos do cartucho (28 g de n.º 7½: cerca de 350–400)</li><li><b aria-hidden=\"true\">4</b>Para avaliar o choke: 35 m ou 40 jardas (para o ajuste da arma: cerca de 15 m)</li><li><b aria-hidden=\"true\">5</b>Aproximadamente quanto chumbo cai no círculo</li></ol><figcaption>As percentagens são aproximadas e dependem do cartucho. Faça pelo menos 3–5 disparos para cada combinação de choke e cartucho.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"De forma aproximada, a essa distância o <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (cilíndrico)</a> coloca cerca de 40% do chumbo dentro do círculo, o improved cylinder cerca de 50%, o modified cerca de 60%, o improved modified cerca de 65%, e o full 70% ou mais. Os valores dependem do cartucho, por isso a sua arma e o seu cartucho podem dar resultados diferentes.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Um único tiro prova pouco: as chumbadas variam de forma notável mesmo com cartuchos idênticos. Dispare pelo menos 3 a 5 tiros para cada combinação. Observe também a uniformidade: uma boa chumbada é uniforme, sem grandes falhas e sem uma mancha densa no meio.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Depois de atirar, desaperte os chokes com a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/choke-key/\"><span lang=\"en\">choke key</span> (chave de chokes)</a>.","Limpe-os por dentro e por fora com solvente e uma escova, e limpe a rosca na <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/muzzle/\"><span lang=\"en\">muzzle</span> (boca do cano)</a>.","Antes de os voltar a aparafusar, ponha uma fina camada de <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (massa para chokes)</a> na rosca: evita a ferrugem e impede que o choke fique preso."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Verifique se os chokes estão bem apertados antes de cada sessão, porque o tiro pode desapertá-los lentamente. Aparafuse-os totalmente com a chave, mas sem força excessiva.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Nunca dispare uma arma de <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (chokes intermutáveis)</a> sem um choke colocado, ou com um choke só a meio aparafusado. O chumbo e a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/pt/glossary/wad/\"><span lang=\"en\">wad</span> (bucha)</a> podem danificar a rosca da boca, e a reparação é cara. Guarde chokes sobresselentes numa caixa separada para não se perderem.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"As chumbadas verificam-se numa placa: a adaptação a cerca de 15 m (16 yards), os chokes a 35 m ou 40 jardas.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Conte a percentagem de chumbo num círculo de 75–76 cm; dispare 3 a 5 tiros.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Limpe os chokes depois de atirar e lubrifique as roscas com massa para chokes.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Verifique se os chokes estão bem apertados antes de cada sessão.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Não dispare uma arma de chokes intermutáveis sem um choke colocado.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Depois de cada tiro, a placa de chumbada é pintada ou engraxada de novo, com um rolo ou um pincel, para que as marcas seguintes não se misturem com as anteriores."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Porque não deve disparar uma arma de multichoke (chokes intermutáveis) sem um choke colocado?","options":[{"k":"a","text":"É proibido só em competições"},{"k":"b","text":"O chumbo e a wad podem danificar a rosca da boca"},{"k":"c","text":"A arma simplesmente não dispara"},{"k":"d","text":"A pattern fica demasiado fechada"}],"correct":"b","explain":"Sem um choke a rosca fica exposta, e o chumbo e a bucha podem danificá-la."},{"k":"chokes-pattern-testing-and-care-q2","q":"A que distância clássica se avalia a pattern (chumbada) de um choke?","options":[{"k":"a","text":"5 m (cerca de 5½ jardas)"},{"k":"b","text":"15 m (cerca de 16 jardas)"},{"k":"c","text":"35 m ou 40 jardas (cerca de 37 m)"},{"k":"d","text":"80 m (cerca de 87 jardas)"}],"correct":"c","explain":"A percentagem de chumbo num círculo de 75–76 cm conta-se classicamente a 35 m ou 40 jardas."},{"k":"chokes-pattern-testing-and-care-q3","q":"Quantos tiros deve disparar para avaliar uma pattern (chumbada)?","options":[{"k":"a","text":"Pelo menos 3 a 5 por cada par"},{"k":"b","text":"Um só tiro já basta"},{"k":"c","text":"Exatamente dois, um por cano"},{"k":"d","text":"Cem, no mesmo dia"}],"correct":"a","explain":"As chumbadas variam de tiro para tiro, por isso precisa de uma série para cada arma, choke e cartucho."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"placa de chumbada","label":"Pattern plate (placa de chumbada)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"chumbada","label":"Pattern (chumbada)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/pattern/"},{"id":"choke","en":"Choke","local":"","label":"Choke","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"chokes intermutáveis","label":"Multichoke (chokes intermutáveis)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"chave de chokes","label":"Choke key (chave de chokes)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"massa para chokes","label":"Choke grease (massa para chokes)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"adaptação da coronha","label":"Gun fit (adaptação da coronha)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"bucha","label":"Wad (bucha)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"cilíndrico","label":"Cylinder (cilíndrico)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"1/4 de choke","label":"Improved cylinder (1/4 de choke)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"1/2 choke","label":"Modified (1/2 choke)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"3/4 de choke","label":"Improved modified (3/4 de choke)","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"","label":"Full choke","url":"https://juliabezdolna.github.io/clayaway/pt/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
