\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">стріляна гільза: зазвичай 65–70 мм</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Гільза (пластикова або паперова)</li><li><b aria-hidden=\"true\">2</b>Металева головка</li><li><b aria-hidden=\"true\">3</b>Капсуль</li><li><b aria-hidden=\"true\">4</b>Порох</li><li><b aria-hidden=\"true\">5</b>Пиж</li><li><b aria-hidden=\"true\">6</b>Дріб</li><li><b aria-hidden=\"true\">7</b>Закрутка «зірочка» (6 або 8 складок)</li></ol><figcaption>Що всередині одного патрона, від металевої головки до закрутки.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"Гільза — трубка, найчастіше пластикова, з металевою головкою знизу. Бувають і паперові гільзи: деякі стенди віддають їм перевагу, бо вони менше засмічують природу. Стріляна гільза зазвичай має 65–70 мм завдовжки і мусить відповідати <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/chamber/\"><span lang=\"en\">chamber</span> (патроннику)</a> вашої рушниці (див. <a href=\"https://juliabezdolna.github.io/clayaway/learn/gun-gauge-and-barrels/\">Калібр і довжина стволів</a>).","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"У центрі головки стоїть капсуль. Коли ударник б’є по ньому, капсуль дає іскру й запалює порох. Порох не вибухає, а дуже швидко згоряє, і гази виштовхують заряд дробу вперед стволом.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"Між порохом і дробом стоїть пиж. Він працює як пробка: не пропускає гарячі гази повз дробини, пом’якшує поштовх і тримає дріб купно, поки той іде стволом. Пластиковий пиж зазвичай має «чашечку», яка захищає дробини, і часто дає трохи щільніший осип.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/fibre-wad/\"><span lang=\"en\">Fibre wad</span> (пиж із фібри чи повсті)</a> розкладається в природі, тому багато стендів вимагають саме його. Є й біорозкладні пластикові пижі, але їх визнають не всі стенди.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"Над пижем — дріб: кілька сотень маленьких кульок. Зверху гільзу закриває <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/crimp/\"><span lang=\"en\">crimp</span> (закрутка)</a>, найчастіше «зірочка» з 6 або 8 складок. Добра закрутка міцно тримає все на місці й допомагає кожному патрону стріляти так само, як попередній.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"Правила FITASC для Parcours de Chasse – Sporting™ і Compak® Sporting забороняють перезаряджені патрони, тобто стріляні гільзи, споряджені повторно, наприклад удома. Заборонені й розсіювачі (вкладки, що навмисно розкидають дріб ширше) та будь-які інші особливі пристрої всередині патрона. Так само не можна брати суміш дробу різних розмірів або якості, димний порох і трасери (патрони, що лишають світний слід). Тож на змагання беріть заводські патрони, які відповідають правилам.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"На коробці зазвичай вказано <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/gauge/\"><span lang=\"en\">gauge</span> (калібр)</a>, довжину гільзи, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/load-weight/\"><span lang=\"en\">load weight</span> (наважку)</a>, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/shot-size/\"><span lang=\"en\">shot size</span> (номер дробу)</a> чи його діаметр, матеріал дробу й тип пижа, а часто й швидкість. Навчіться читати коробку — і ви знатимете, що заряджаєте.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Деякі стрільбища мають власні екологічні правила для тренувань, наприклад лише фіброві пижі чи лише <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (сталевий дріб)</a>: перевірте правила стрільбища перед поїздкою. Стріляні гільзи кладуть у контейнер на стрілецькому місці, а стрільці з <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span> (напівавтоматами)</a>, сходячи з місця, збирають свої викинуті гільзи.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"Три числа з коробки мають окремі уроки: калібр (<a href=\"https://juliabezdolna.github.io/clayaway/learn/gun-gauge-and-barrels/\">Калібр і довжина стволів</a>), номер дробу (<a href=\"https://juliabezdolna.github.io/clayaway/learn/cartridges-shot-size/\">Номер дробу</a>) і наважка (<a href=\"https://juliabezdolna.github.io/clayaway/learn/cartridges-load-weight/\">Наважка дробу</a>).","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Кладіть стріляні гільзи в контейнер.","say":"Гільзи, будь ласка, в контейнер, а не на траву.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Lead shot (свинцевий дріб) на цьому стрільбищі заборонений (місцеве правило, а не FITASC).","say":"На цьому стрільбищі — лише сталевий дріб.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Патрон = гільза, капсуль, порох, пиж, дріб.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Пластиковий пиж часто дає трохи щільніший осип; фібровий розкладається в природі.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"FITASC забороняє перезаряджені патрони, розсіювачі, суміш дробу, димний порох і трасери.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Читайте коробку: калібр, довжина, наважка, дріб, пиж.","checklist":false},{"k":"gear-cartridges-kp5","html":"Гільзи — у контейнер; власники напівавтоматів збирають свої гільзи.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Пластиковий пиж після пострілу летить ще кілька десятків метрів за стрілецьке місце. Саме тому на полях біля старих стендів можна знайти тисячі пижів, а фібра поступово розкладається."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Що запалює порох у патроні?","options":[{"k":"a","text":"Пиж"},{"k":"b","text":"Капсуль"},{"k":"c","text":"Закрутка"},{"k":"d","text":"Дріб"}],"correct":"b","explain":"Ударник б’є по капсулю, і той запалює порох."},{"k":"cartridges-anatomy-q2","q":"Чому багато стендів вимагають фіброві пижі?","options":[{"k":"a","text":"Вони дешевші"},{"k":"b","text":"Вони дають щільніший осип"},{"k":"c","text":"Вони розкладаються в природі"},{"k":"d","text":"Так вимагає FITASC"}],"correct":"c","explain":"Фібра й повсть розкладаються, а звичайні пластикові пижі залишаються на полях роками."},{"k":"cartridges-anatomy-q3","q":"Які патрони забороняють правила FITASC?","options":[{"k":"a","text":"Заводські з пластиковим пижем"},{"k":"b","text":"Заводські з фібровим пижем"},{"k":"c","text":"Патрони з паперовою гільзою"},{"k":"d","text":"Перезаряджені патрони"}],"correct":"d","explain":"Перезаряджені патрони, розсіювачі, суміш дробу, димний порох і трасери заборонено.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"набій","label":"Cartridge (набій)","url":"https://juliabezdolna.github.io/clayaway/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"гільза","label":"Hull (гільза)","url":"https://juliabezdolna.github.io/clayaway/glossary/hull/"},{"id":"primer","en":"Primer","local":"капсуль","label":"Primer (капсуль)","url":"https://juliabezdolna.github.io/clayaway/glossary/primer/"},{"id":"powder","en":"Powder","local":"порох","label":"Powder (порох)","url":"https://juliabezdolna.github.io/clayaway/glossary/powder/"},{"id":"wad","en":"Wad","local":"пиж","label":"Wad (пиж)","url":"https://juliabezdolna.github.io/clayaway/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"фетровий пиж","label":"Fibre wad (фетровий пиж)","url":"https://juliabezdolna.github.io/clayaway/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"закрутка","label":"Crimp (закрутка)","url":"https://juliabezdolna.github.io/clayaway/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"патронник","label":"Chamber (патронник)","url":"https://juliabezdolna.github.io/clayaway/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"стріляні гільзи","label":"Empty cases (стріляні гільзи)","url":"https://juliabezdolna.github.io/clayaway/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"напівавтомат","label":"Semi-automatic (напівавтомат)","url":"https://juliabezdolna.github.io/clayaway/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"сталевий дріб","label":"Steel shot (сталевий дріб)","url":"https://juliabezdolna.github.io/clayaway/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"номер дробу","label":"Shot size (номер дробу)","url":"https://juliabezdolna.github.io/clayaway/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"наважка","label":"Load weight (наважка)","url":"https://juliabezdolna.github.io/clayaway/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"калібр","label":"Gauge (калібр)","url":"https://juliabezdolna.github.io/clayaway/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Розділ 7 · Вимоги до патронів","url":"https://juliabezdolna.github.io/clayaway/rules/sporting/weapons-and-ammunition/#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Розділ 18 · Заборонені набої","url":"https://juliabezdolna.github.io/clayaway/rules/compak/shooting-equipment/#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Розділ 8 · Не обертатися з закритою рушницею; гільзи","url":"https://juliabezdolna.github.io/clayaway/rules/sporting/rules-of-conduct-safety/#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Розділ 18 · Утилізація гільз","url":"https://juliabezdolna.github.io/clayaway/rules/compak/shooting-equipment/#ch18-empty-cases"}],"sources":[{"title":"FITASC — офіційні правила Parcours de Chasse – Sporting™ і Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — таблиці розмірів патронів і патронників (TDCC), зокрема дробових","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
