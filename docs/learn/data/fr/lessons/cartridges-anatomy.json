5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">douille tirée : en général 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Douille (plastique ou carton)</li><li><b aria-hidden=\"true\">2</b>Culot métallique</li><li><b aria-hidden=\"true\">3</b>Amorce</li><li><b aria-hidden=\"true\">4</b>Poudre</li><li><b aria-hidden=\"true\">5</b>Bourre</li><li><b aria-hidden=\"true\">6</b>Plombs</li><li><b aria-hidden=\"true\">7</b>Sertissage en étoile (6 ou 8 plis)</li></ol><figcaption>Ce qu’il y a dans une cartouche, du culot métallique au sertissage.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"La douille, ou étui, est un tube, le plus souvent en plastique, avec une tête métallique à la base. Il existe aussi des douilles en papier, que certains stands préfèrent car elles laissent moins de déchets. Une douille tirée mesure généralement 65 à 70 mm, et elle doit correspondre au <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/chamber/\"><span lang=\"en\">chamber</span> (chambre)</a> de votre fusil (voir <a href=\"https://juliabezdolna.github.io/clayaway/fr/learn/gun-gauge-and-barrels/\">Calibre et longueur des canons</a>).","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"Au centre de la tête se trouve l'amorce. Quand le chien la frappe, l'amorce produit une étincelle et enflamme la poudre. La poudre n'explose pas, mais brûle très vite, et les gaz poussent le <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/load-weight/\"><span lang=\"en\">load weight</span> (charge de plomb)</a> dans le canon.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"Entre la poudre et le plomb se trouve la bourre. Elle fonctionne comme un bouchon : elle empêche le gaz chaud de passer entre les plombs, amortit la poussée et garde les plombs groupés pendant leur trajet dans le canon. Une bourre en plastique a généralement une coupelle qui protège les plombs et donne souvent un <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/pattern/\"><span lang=\"en\">pattern</span> (gerbe)</a> légèrement plus serré.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"Un <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/fibre-wad/\"><span lang=\"en\">fibre wad</span> (bourre en fibre ou en feutre)</a> se décompose dans la nature, c'est pourquoi beaucoup de stands l'exigent. Il existe aussi des bourres en plastique biodégradables, mais certains stands ne les acceptent pas.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"Au-dessus de la bourre se trouve le plomb : plusieurs centaines de petites billes. Le haut de la douille est fermé par le <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/crimp/\"><span lang=\"en\">crimp</span> (sertissage)</a>, le plus souvent en étoile à 6 ou 8 plis. Un bon sertissage maintient tout fermement en place et aide chaque cartouche à partir comme la précédente.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"Le règlement FITASC du Parcours de Chasse – Sporting™ et du Compak® Sporting interdit les <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/reloaded-cartridge/\"><span lang=\"en\">reloaded cartridges</span> (cartouches rechargées)</a>, c'est-à-dire des douilles tirées remplies à nouveau, par exemple chez soi. Il interdit aussi les disperseurs (des inserts qui écartent volontairement le plomb) et tout autre dispositif spécial à l'intérieur de la cartouche. Un mélange de plombs de tailles ou de qualités différentes, la poudre noire et les traçantes (des cartouches qui laissent une traînée lumineuse) sont également interdits. Pour les compétitions, apportez donc des cartouches d'usine conformes au règlement.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"La boîte indique généralement le <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/gauge/\"><span lang=\"en\">gauge</span> (calibre)</a>, la longueur de la douille, la charge, le numéro ou le diamètre du plomb, le matériau du plomb et le type de bourre, et souvent la vitesse. Apprenez à lire la boîte, et vous saurez ce que vous chargez.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Certains stands ajoutent leurs propres règles environnementales pour l'entraînement, par exemple bourres fibre uniquement ou <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (billes d'acier)</a> uniquement : vérifiez les règles du stand avant un déplacement. Les douilles vides vont dans la poubelle au poste, et les tireurs en <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span> (semi-automatique)</a> ramassent leurs douilles éjectées en partant.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"Trois chiffres de la boîte ont chacun leur propre leçon : le calibre dans <a href=\"https://juliabezdolna.github.io/clayaway/fr/learn/gun-gauge-and-barrels/\">Calibre et longueur des canons</a>, le <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/shot-size/\"><span lang=\"en\">shot size</span> (numéro de plomb)</a> dans <a href=\"https://juliabezdolna.github.io/clayaway/fr/learn/cartridges-shot-size/\">Numéro de plomb</a> et la charge dans <a href=\"https://juliabezdolna.github.io/clayaway/fr/learn/cartridges-load-weight/\">La charge de plomb</a>.","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Mettez les douilles tirées dans le conteneur.","say":"Les douilles dans la poubelle, s'il vous plaît, pas dans l'herbe.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Le plomb de chasse n'est pas autorisé sur ce stand (règle locale, pas une règle FITASC).","say":"Acier uniquement sur ce stand.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Cartouche = douille, amorce, poudre, bourre, plomb.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Bourre plastique : souvent une gerbe un peu plus serrée ; bourre fibre : se décompose dans la nature.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"La FITASC interdit les cartouches rechargées, les disperseurs, les mélanges de plomb, la poudre noire et les traçantes.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Lisez la boîte : calibre, longueur, charge, plomb, bourre.","checklist":false},{"k":"gear-cartridges-kp5","html":"Les douilles vont à la poubelle ; les utilisateurs de semi-automatique ramassent les leurs.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Après le tir, une bourre en plastique continue sur plusieurs dizaines de mètres au-delà du poste. C'est pourquoi les champs autour des vieux stands peuvent être couverts de bourres, alors que la fibre se décompose peu à peu."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Qu'est-ce qui enflamme le powder (poudre) dans un cartridge (cartouche) ?","options":[{"k":"a","text":"La bourre"},{"k":"b","text":"L'amorce"},{"k":"c","text":"Le sertissage"},{"k":"d","text":"Le plomb"}],"correct":"b","explain":"Le chien frappe le primer (amorce), qui enflamme la poudre."},{"k":"cartridges-anatomy-q2","q":"Pourquoi beaucoup de stands exigent-ils des fibre wads (bourres fibre) ?","options":[{"k":"a","text":"Elles sont moins chères"},{"k":"b","text":"Elles donnent un gerbe plus serré"},{"k":"c","text":"Elles se décomposent dans la nature"},{"k":"d","text":"La FITASC l'exige"}],"correct":"c","explain":"La fibre et le feutre se décomposent, alors que les bourres plastique ordinaires restent des années dans les champs."},{"k":"cartridges-anatomy-q3","q":"Quelles cartridges (cartouches) le règlement FITASC interdit-il ?","options":[{"k":"a","text":"Les cartouches d'usine à wad plastique"},{"k":"b","text":"Les cartouches d'usine à fibre wad"},{"k":"c","text":"Les cartouches à hull papier"},{"k":"d","text":"Les reloaded cartridges"}],"correct":"d","explain":"Les cartouches rechargées, les disperseurs, les mélanges de plomb, la poudre noire et les traçantes sont interdits.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"cartouche","label":"Cartridge (cartouche)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"douille","label":"Hull (douille)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/hull/"},{"id":"primer","en":"Primer","local":"amorce","label":"Primer (amorce)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/primer/"},{"id":"powder","en":"Powder","local":"poudre","label":"Powder (poudre)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/powder/"},{"id":"wad","en":"Wad","local":"bourre","label":"Wad (bourre)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"bourre grasse","label":"Fibre wad (bourre grasse)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"sertissage","label":"Crimp (sertissage)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"chambre","label":"Chamber (chambre)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"cartouches vides","label":"Empty cases (cartouches vides)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"semi-automatique","label":"Semi-automatic (semi-automatique)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"billes d'acier","label":"Steel shot (billes d'acier)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"numéro de plomb","label":"Shot size (numéro de plomb)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"charge","label":"Load weight (charge)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"calibre","label":"Gauge (calibre)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Chapitre 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=fr#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Chapitre 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=fr#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Chapitre 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=fr#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Chapitre 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=fr#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
