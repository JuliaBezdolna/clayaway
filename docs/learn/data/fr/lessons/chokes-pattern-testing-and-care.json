12.9\" cy=\"139.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"309.7\" cy=\"205.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"246.3\" cy=\"123.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"381.0\" cy=\"151.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"237.6\" cy=\"228.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"299.0\" cy=\"126.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"339.0\" cy=\"198.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"227.4\" cy=\"155.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"367.8\" cy=\"107.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"297.2\" cy=\"178.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"275.0\" cy=\"124.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"361.4\" cy=\"174.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"231.1\" cy=\"196.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.5\" cy=\"76.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"312.6\" cy=\"187.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"251.7\" cy=\"140.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"366.0\" cy=\"138.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"259.6\" cy=\"230.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"297.1\" cy=\"149.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"333.9\" cy=\"181.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"240.8\" cy=\"168.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"347.4\" cy=\"103.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"306.2\" cy=\"245.5\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"281.2\" cy=\"143.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"349.0\" cy=\"160.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"249.9\" cy=\"201.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"308.7\" cy=\"82.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"356.7\" cy=\"233.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"264.3\" cy=\"153.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"348.3\" cy=\"132.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"279.7\" cy=\"226.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"261.1\" cy=\"85.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"318.8\" cy=\"166.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"257.9\" cy=\"175.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"328.1\" cy=\"105.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"322.3\" cy=\"232.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"220.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 yards</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Une feuille de papier d’environ 1 × 1 m, ou une plaque de gerbe</li><li><b aria-hidden=\"true\">2</b>Un cercle de 75–76 cm de diamètre autour de la partie la plus dense</li><li><b aria-hidden=\"true\">3</b>Comptez les impacts dans le cercle et comparez au nombre de plombs de la cartouche (28 g de n° 7½ : environ 350–400)</li><li><b aria-hidden=\"true\">4</b>Pour juger le choke : 35 m ou 40 yards (pour l’ajustement du fusil : environ 15 m)</li><li><b aria-hidden=\"true\">5</b>La part approximative des plombs dans le cercle</li></ol><figcaption>Les pourcentages sont approximatifs et dépendent de la cartouche. Tirez au moins 3 à 5 coups pour chaque choke et chaque cartouche.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"Approximativement, à cette distance, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (lisse)</a> place environ 40 % du plomb dans le cercle, improved cylinder environ 50 %, modified environ 60 %, improved modified environ 65 %, et full 70 % ou plus. Les chiffres dépendent de la cartouche, donc votre propre fusil et vos propres cartouches peuvent donner des résultats différents.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Un seul coup ne prouve pas grand-chose : les gerbes varient sensiblement, même avec des cartouches identiques. Tirez au moins 3 à 5 coups pour chaque combinaison. Regardez aussi la régularité : une bonne gerbe est régulière, sans grands trous et sans amas dense au centre.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Après le tir, dévissez les chokes avec le <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/choke-key/\"><span lang=\"en\">choke key</span> (clé à choke)</a>.","Nettoyez-les à l'intérieur et à l'extérieur avec un solvant et une brosse, et essuyez le filetage dans la bouche.","Avant de les revisser, mettez une fine couche de <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (graisse à chokes)</a> sur le filetage : elle empêche la rouille et évite que le choke ne se grippe."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Vérifiez que les chokes sont bien serrés avant chaque séance, car le tir peut peu à peu les desserrer. Vissez-les complètement avec la clé, mais sans forcer excessivement.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Ne tirez jamais avec un fusil à <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (chokes interchangeables)</a> sans choke, ou avec un choke seulement à moitié vissé. Le plomb et le <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fr/glossary/wad/\"><span lang=\"en\">wad</span> (bourre)</a> peuvent endommager le filetage de la bouche, et la réparation coûte cher. Gardez les chokes de rechange dans un étui séparé pour ne pas les perdre.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"Les gerbes se vérifient sur une plaque : la conformation à environ 15 m (16 yards), les chokes à 35 m ou 40 yards.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Comptez la part du plomb dans un cercle de 75-76 cm ; tirez 3 à 5 coups.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Nettoyez les chokes après le tir et graissez les filetages avec de la graisse à chokes.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Vérifiez que les chokes sont bien serrés avant chaque séance.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Ne tirez pas avec un fusil à chokes interchangeables sans choke installé.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Après chaque coup, la plaque de gerbe est repeinte ou regraissée, au rouleau ou au pinceau, pour que les nouvelles marques ne se mélangent pas aux précédentes."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Pourquoi ne faut-il pas tirer avec un fusil à multichoke (chokes interchangeables) sans choke ?","options":[{"k":"a","text":"C'est interdit seulement en compétition"},{"k":"b","text":"Le plomb et le wad peuvent endommager le filetage de la bouche"},{"k":"c","text":"Le fusil ne partira alors pas du tout"},{"k":"d","text":"Le pattern devient beaucoup trop serré"}],"correct":"b","explain":"Sans choke, le filetage est exposé, et le plomb et la bourre peuvent l'endommager."},{"k":"chokes-pattern-testing-and-care-q2","q":"À quelle distance classique juge-t-on le pattern (gerbe) d'un choke ?","options":[{"k":"a","text":"5 m (environ 5½ yards)"},{"k":"b","text":"15 m (environ 16 yards)"},{"k":"c","text":"35 m ou 40 yards (environ 37 m)"},{"k":"d","text":"80 m (environ 87 yards)"}],"correct":"c","explain":"La part du plomb dans un cercle de 75-76 cm se compte classiquement à 35 m ou 40 yards."},{"k":"chokes-pattern-testing-and-care-q3","q":"Combien de coups faut-il tirer pour juger un pattern (gerbe) ?","options":[{"k":"a","text":"Au moins 3 à 5 pour chaque combinaison"},{"k":"b","text":"Un seul coup suffit pour cela"},{"k":"c","text":"Exactement deux, un par canon"},{"k":"d","text":"Une centaine, le même jour"}],"correct":"a","explain":"Les gerbes varient d'un coup à l'autre, donc il faut une série pour chaque combinaison de fusil, de choke et de cartouche."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"plaque de gerbe","label":"Pattern plate (plaque de gerbe)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"gerbe","label":"Pattern (gerbe)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/pattern/"},{"id":"choke","en":"Choke","local":"","label":"Choke","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"chokes interchangeables","label":"Multichoke (chokes interchangeables)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"clé à choke","label":"Choke key (clé à choke)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"graisse à chokes","label":"Choke grease (graisse à chokes)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"conformation","label":"Gun fit (conformation)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"bourre","label":"Wad (bourre)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"lisse","label":"Cylinder (lisse)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"quart de choke","label":"Improved cylinder (quart de choke)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"demi-choke","label":"Modified (demi-choke)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"trois-quarts de choke","label":"Improved modified (trois-quarts de choke)","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"","label":"Full choke","url":"https://juliabezdolna.github.io/clayaway/fr/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
