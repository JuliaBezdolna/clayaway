"232.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"220.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 jardų</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Maždaug 1 × 1 m popieriaus lapas arba šaudymo plokštė</li><li><b aria-hidden=\"true\">2</b>75–76 cm skersmens apskritimas aplink tankiausią dalį</li><li><b aria-hidden=\"true\">3</b>Suskaičiuokite pėdsakus viduje ir palyginkite su šratų skaičiumi šovinyje (28 g Nr. 7½: apie 350–400)</li><li><b aria-hidden=\"true\">4</b>Čokui įvertinti: 35 m arba 40 jardų (šautuvo pritaikymui – apie 15 m)</li><li><b aria-hidden=\"true\">5</b>Apytikslė šratų dalis apskritime</li></ol><figcaption>Procentai apytiksliai ir priklauso nuo šovinio. Kiekvienam čoko ir šovinio deriniui iššaukite bent 3–5 šūvius.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"Apytiksliai, tokiu atstumu <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (cilindras)</a> į ratą sudeda apie 40 % šratų, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/improved-cylinder/\"><span lang=\"en\">improved cylinder</span> (ketvirtis)</a> – apie 50 %, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/modified/\"><span lang=\"en\">modified</span> (pusčokas)</a> – apie 60 %, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/improved-modified/\"><span lang=\"en\">improved modified</span> (trys ketvirčiai)</a> – apie 65 %, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/full-choke/\"><span lang=\"en\">full choke</span> (pilnas čokas)</a> – 70 % ir daugiau. Skaičiai priklauso nuo šovinio, tad jūsų pati šautuvo ir šovinio pora gali duoti kitokį rezultatą.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Vienas šūvis mažai ką parodo: spiečiai pastebimai skiriasi net su vienodais šoviniais. Paleiskite bent 3–5 šūvius kiekvienai kombinacijai. Žiūrėkite ir į tolygumą: geras spiečius tolygus, be didelių „plyšių“ ir be tankaus gumulo viduryje.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Po šaudymo išsukite čokus <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/choke-key/\"><span lang=\"en\">choke key</span> (čokų raktu)</a>.","Nuvalykite juos iš vidaus ir iš išorės valymo tirpalu ir šepetėliu, nuvalykite sriegį žiotyse.","Prieš sukdami atgal, ant sriegio uždėkite plonų <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (čokų tepalo)</a> sluoksnį: jis saugo nuo rūdžių ir neleidžia čokui „prikibti“."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Prieš kiekvieną treniruotę patikrinkite, ar čokai tvirtai įsukti, nes nuo šaudymo jie gali pamažu atsisukti. Sukite raktu iki galo, bet neperdėtai stipriai.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Niekada nešaudykite iš <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (keičiamų čokų)</a> šautuvo be čoko arba su pusiau įsuktu čoku. Šratai ir <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/lt/glossary/wad/\"><span lang=\"en\">wad</span> (kamštelis)</a> gali pažeisti sriegį žiotyse, o remontas kainuoja daug. Atsarginius čokus laikykite atskirame dėkle, kad nepamestumėte.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"Spiečius tikrinamas ant plokštės: pritaikymas – nuo apie 15 m (16 jardų), čokas – nuo 35 m ar 40 jardų.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Skaičiuokite šratų dalį 75–76 cm rate; paleiskite 3–5 šūvius.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Čokus valykite po šaudymo ir tepkite sriegius čokų tepalu.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Prieš kiekvieną treniruotę tikrinkite, ar čokai tvirtai įsukti.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Nešaudykite iš keičiamų čokų šautuvo be čoko.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Po kiekvieno šūvio šaudymo plokštę vėl nuspalvina ar sutepa – voleliu ar šepetėliu, – kad naujos žymės nesusimaišytų su ankstesnėmis."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Kodėl nederėtų šaudyti iš keičiamų čokų šautuvo be čoko?","options":[{"k":"a","text":"Tai draudžiama tik varžybose"},{"k":"b","text":"Šratai ir kamštelis gali pažeisti sriegį žiotyse"},{"k":"c","text":"Tada šautuvas visai nešaus"},{"k":"d","text":"Spiečius tampa pernelyg tankus"}],"correct":"b","explain":"Be čoko sriegis atviras, ir šratai su kamšteliu gali jį pažeisti."},{"k":"chokes-pattern-testing-and-care-q2","q":"Kokiu klasišku atstumu vertinamas čoko spiečius?","options":[{"k":"a","text":"5 m (apie 5½ jardo)"},{"k":"b","text":"15 m (apie 16 jardų)"},{"k":"c","text":"35 m arba 40 jardų (apie 37 m)"},{"k":"d","text":"80 m (apie 87 jardus)"}],"correct":"c","explain":"Šratų dalis 75–76 cm rate klasiškai skaičiuojama nuo 35 m arba 40 jardų."},{"k":"chokes-pattern-testing-and-care-q3","q":"Kiek šūvių paleisti, vertinant spiečių?","options":[{"k":"a","text":"Bent 3–5 kiekvienai porai"},{"k":"b","text":"Tam pakanka vieno šūvio"},{"k":"c","text":"Lygiai du, po vieną į vamzdį"},{"k":"d","text":"Šimtą, tą pačią dieną"}],"correct":"a","explain":"Spiečiai skiriasi nuo šūvio iki šūvio, tad kiekvienai porai „čokas + šovinys“ reikia serijos."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"šaudymo plokštė","label":"Pattern plate (šaudymo plokštė)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"šratų spiečius","label":"Pattern (šratų spiečius)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/pattern/"},{"id":"choke","en":"Choke","local":"čokas","label":"Choke (čokas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"keičiami čokai","label":"Multichoke (keičiami čokai)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"čokų raktas","label":"Choke key (čokų raktas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"čokų tepalas","label":"Choke grease (čokų tepalas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"ginklo pritaikymas","label":"Gun fit (ginklo pritaikymas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"kamštelis","label":"Wad (kamštelis)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"cilindras","label":"Cylinder (cilindras)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"ketvirtinis čokas","label":"Improved cylinder (ketvirtinis čokas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"pusčokas","label":"Modified (pusčokas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"trys ketvirčiai","label":"Improved modified (trys ketvirčiai)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"pilnas čokas","label":"Full choke (pilnas čokas)","url":"https://juliabezdolna.github.io/clayaway/lt/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
