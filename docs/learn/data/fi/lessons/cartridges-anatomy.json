"329.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">ammuttu hylsy: yleensä 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Hylsy (muovia tai paperia)</li><li><b aria-hidden=\"true\">2</b>Metallipohja</li><li><b aria-hidden=\"true\">3</b>Nalli</li><li><b aria-hidden=\"true\">4</b>Ruuti</li><li><b aria-hidden=\"true\">5</b>Välitulppa</li><li><b aria-hidden=\"true\">6</b>Haulit</li><li><b aria-hidden=\"true\">7</b>Tähtisuljenta (6 tai 8 taitetta)</li></ol><figcaption>Mitä yhden patruunan sisällä on, metallipohjasta tähtisuljentaan.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/hull/\"><span lang=\"en\">Hull</span></a> (englanniksi myös case) on putki, useimmiten muovia, metallisella päällä alhaalla. Paperihylsyjäkin on; jotkin radat suosivat niitä, koska ne jättävät vähemmän roskaa. Ammuttu hylsy on tavallisesti 65–70 mm pitkä, ja sen on sovittava aseesi <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/chamber/\"><span lang=\"en\">chamber</span> (patruunapesään)</a> – katso <a href=\"https://juliabezdolna.github.io/clayaway/fi/learn/gun-gauge-and-barrels/\">Kaliiperi ja piippujen pituus</a>.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"Päällimmäisen keskellä on nalli. Kun iskuri osuu siihen, nalli antaa kipinän ja sytyttää ruudin. Ruuti ei räjähdä, vaan palaa erittäin nopeasti, ja kaasut työntävät haulipanoksen eteenpäin piippua pitkin.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"Ruudin ja haulien välissä on välitulppa. Se toimii tulpan tavoin: estää kuumien kaasujen puhaltamisen haulien ohi, pehmentää työntöä ja pitää haulit koossa niiden kulkiessa piippua pitkin. Muovisessa välitulpassa on tavallisesti kuppi, joka suojaa hauleja ja antaa usein hieman tiiviimmän <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/pattern/\"><span lang=\"en\">pattern</span> (osumakuvion)</a>.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/fibre-wad/\"><span lang=\"en\">Fibre wad</span> (huopatulppa)</a> hajoaa luonnossa, niin monet radat vaativat juuri sitä. Biohajoavia muovitulppiakin on, mutta jotkin radat eivät hyväksy niitä.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"Välitulpan päällä on haulit: useita satoja pieniä rakeita. Hylsyn yläreuna on suljettu <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/crimp/\"><span lang=\"en\">crimp</span> (tähtisuljennalla)</a>, useimmiten 6 tai 8 laskoksen tähdellä. Hyvä tähtisuljenta pitää kaiken tiukasti paikallaan ja auttaa joka patruunaa laukeamaan samalla tavalla kuin edellisen.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"Parcours de Chasse – Sporting™- ja Compak® Sporting-lajien FITASC-säännöt kieltävät uudelleenladatut patruunat, eli ammutut hylsyt, jotka on täytetty uudelleen, esimerkiksi kotona. Kiellettyjä ovat myös hajottimet (lisäosat, jotka tarkoituksella levittävät haulit laajemmalle) ja mikä tahansa muu erityinen laite patruunan sisällä. Samoin kiellettyjä ovat eri kokoisten tai laatuisten haulien sekoitukset, mustaruuti ja valojuovapatruunat (patruunat, jotka jättävät hohtavan jäljen). Ota siis kilpailuihin tehtaan patruunoita, jotka täyttävät säännöt.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"Rasiassa näkyy tavallisesti <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/gauge/\"><span lang=\"en\">gauge</span> (kaliiperi)</a>, hylsyn pituus, lataus, haulinumero tai -halkaisija, haulin materiaali ja välitulpan tyyppi, usein myös nopeus. Opi lukemaan rasia, ja tiedät, millä lataat.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Jotkin radat lisäävät harjoituksiin omia ympäristösääntöjään, esimerkiksi vain <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/fibre-wad/\"><span lang=\"en\">fibre wad</span></a> tai vain <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (teräshaulit)</a>: tarkista radan säännöt ennen matkaa. Tyhjät hylsyt laitetaan ampumapaikan astiaan, ja <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span> (puoliautomaatilla)</a> ampuvat keräävät poistuessaan aseensa heittämät hylsyt.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"Kolmella rasian luvulla on omat oppituntinsa: kaliiperi: <a href=\"https://juliabezdolna.github.io/clayaway/fi/learn/gun-gauge-and-barrels/\">Kaliiperi ja piippujen pituus</a>; <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/shot-size/\"><span lang=\"en\">shot size</span> (haulikoko)</a>: <a href=\"https://juliabezdolna.github.io/clayaway/fi/learn/cartridges-shot-size/\">Haulikoko</a>; lataus: <a href=\"https://juliabezdolna.github.io/clayaway/fi/learn/cartridges-load-weight/\">Haulilataus</a>.","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Laita ammutut hylsyt astiaan.","say":"Hylsyt astiaan, kiitos, ei nurmikolle.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Lead shot (lyijyhaulit) eivät ole sallittuja tällä radalla (radan oma sääntö, ei FITASCin).","say":"Tällä radalla vain teräshauleja.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Patruuna = hylsy, nalli, ruuti, välitulppa, haulit.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Muovitulppa: usein hieman tiiviimpi osumakuvio; huopatulppa: hajoaa luonnossa.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"FITASC kieltää uudelleenlatauksen, hajottimet, haulien sekoitukset, mustaruudin ja valojuovapatruunat.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Lue rasia: kaliiperi, pituus, lataus, haulit, välitulppa.","checklist":false},{"k":"gear-cartridges-kp5","html":"Hylsyt astiaan; puoliautomaatin käyttäjät keräävät hylsynsä.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Laukauksen jälkeen muovitulppa lentää vielä useita kymmeniä metrejä ampumapaikan ohi. Siksi vanhojen ratojen ympärillä olevat pellot voivat olla täynnä tulppia, kun huopa sitä vastoin vähitellen hajoaa."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Mikä sytyttää ruudin patruunassa?","options":[{"k":"a","text":"Välitulppa"},{"k":"b","text":"Nalli"},{"k":"c","text":"Tähtisuljenta"},{"k":"d","text":"Haulit"}],"correct":"b","explain":"Iskuri osuu nalliin, ja se sytyttää ruudin."},{"k":"cartridges-anatomy-q2","q":"Miksi monet radat vaativat huopatulppia?","options":[{"k":"a","text":"Ne ovat halvempia"},{"k":"b","text":"Ne antavat tiiviimmän osumakuvion"},{"k":"c","text":"Ne hajoavat luonnossa"},{"k":"d","text":"FITASC vaatii sitä"}],"correct":"c","explain":"Huopa ja kuitu hajoavat, kun tavalliset muovitulpat jäävät pelloille vuosiksi."},{"k":"cartridges-anatomy-q3","q":"Mitkä patruunat FITASCin säännöt kieltävät?","options":[{"k":"a","text":"Tehtaan patruunat muovitulpalla"},{"k":"b","text":"Tehtaan patruunat huopatulpalla"},{"k":"c","text":"Paperihylsyiset patruunat"},{"k":"d","text":"Uudelleenladatut patruunat"}],"correct":"d","explain":"Uudelleenladatut patruunat, hajottimet, haulien sekoitukset, mustaruuti ja valojuovapatruunat on kielletty.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"patruuna","label":"Cartridge (patruuna)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"hylsy","label":"Hull (hylsy)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/hull/"},{"id":"primer","en":"Primer","local":"nalli","label":"Primer (nalli)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/primer/"},{"id":"powder","en":"Powder","local":"ruuti","label":"Powder (ruuti)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/powder/"},{"id":"wad","en":"Wad","local":"välitulppa","label":"Wad (välitulppa)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"huopatulppa","label":"Fibre wad (huopatulppa)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"tähtisuljenta","label":"Crimp (tähtisuljenta)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"patruunapesä","label":"Chamber (patruunapesä)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"hylsyt","label":"Empty cases (hylsyt)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"puoliautomaattihaulikko","label":"Semi-automatic (puoliautomaattihaulikko)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"teräshaulit","label":"Steel shot (teräshaulit)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"haulikoko","label":"Shot size (haulikoko)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"haulilataus","label":"Load weight (haulilataus)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"kaliiperi","label":"Gauge (kaliiperi)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Luku 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=fi#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Luku 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=fi#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Luku 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=fi#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Luku 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=fi#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
