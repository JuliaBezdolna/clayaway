\"/><circle class=\"dg-hole\" cx=\"257.9\" cy=\"175.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"328.1\" cy=\"105.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"322.3\" cy=\"232.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"220.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 jaardia</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Noin 1 × 1 m:n paperiarkki tai koeammuntalevy</li><li><b aria-hidden=\"true\">2</b>Halkaisijaltaan 75–76 cm:n ympyrä tiheimmän kohdan ympärille</li><li><b aria-hidden=\"true\">3</b>Laske reiät ympyrän sisältä ja vertaa patruunan haulimäärään (28 g nro 7½: noin 350–400)</li><li><b aria-hidden=\"true\">4</b>Supistajan arviointiin: 35 m tai 40 jaardia (aseen sovitukseen noin 15 m)</li><li><b aria-hidden=\"true\">5</b>Suunnilleen näin suuri osa hauleista osuu ympyrään</li></ol><figcaption>Prosentit ovat suuntaa antavia ja riippuvat patruunasta. Ammu jokaisella supistajan ja patruunan yhdistelmällä vähintään 3–5 laukausta.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"Karkeasti, tällä etäisyydellä <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (sylinteri)</a> osuu ympyrään noin 40 %:lla hauleista, improved cylinder noin 50 %:lla, modified noin 60 %:lla, improved modified noin 65 %:lla ja full 70 % tai enemmän. Luvut riippuvat patruunasta, niin oma ase- ja patruunayhdistelmäsi voi antaa eri tuloksen.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Yksi laukaus kertoo vähän: osumakuviot vaihtelevat huomattavasti jopa samanlaisilla patruunoilla. Ammu vähintään 3–5 laukausta joka yhdistelmälle. Katso myös tasaisuutta: hyvä osumakuvio on tasainen, ilman suuria aukkoja ja ilman tiivistä läikkää keskellä.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Ampumisen jälkeen kierrä supistajat irti <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/choke-key/\"><span lang=\"en\">choke key</span> (supistaja-avaimella)</a>.","Puhdista ne sisältä ja ulkoa puhdistusaineella ja harjalla, ja pyyhi piipunsuun kierteet.","Ennen takaisin kiertämistä laita kierteisiin ohut kerros <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (supistajarasvaa)</a>: se estää ruostumista ja pitää supistajan kiertyvänä."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Tarkista ennen joka tuntia, että supistajat ovat tiukassa, koska ampuminen voi vähitellen löysätä niitä. Kierrä ne kokonaan kiinni avaimella, mutta älä käytä liikaa voimaa.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Älä koskaan ammu <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (vaihtosupistaja-aseesta)</a> ilman supistajaa tai puoliksi kierrettynä. Haulit ja <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/wad/\"><span lang=\"en\">wad</span> (välitulppa)</a> voivat vahingoittaa piipunsuun kierteitä, ja korjaus on kallis. Säilytä varasupistajat erillisessä kotelossa, jotta ne eivät katoa.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"Osumakuviot tarkistetaan levyllä: sovitus noin 15 m (16 jaardia) etäisyydeltä, supistajat 35 m:n tai 40 jaardin etäisyydeltä.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Laske haulien osuus 75–76 cm:n ympyrässä; ammu 3–5 laukausta.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Puhdista supistajat ampumisen jälkeen ja rasvaa kierteet supistajarasvalla.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Tarkista ennen joka tuntia, että supistajat ovat tiukassa.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Älä koskaan ammu vaihtosupistaja-aseesta ilman supistajaa.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Joka laukauksen jälkeen koeammuntalevy maalataan tai rasvataan uudelleen telalla tai harjalla, jotta seuraavat jäljet eivät sekoitu edellisiin."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Miksi ei pidä ampua vaihtosupistaja-aseesta ilman supistajaa?","options":[{"k":"a","text":"Se on kielletty vain kilpailuissa"},{"k":"b","text":"Haulit ja välitulppa voivat vahingoittaa piipunsuun kierteitä"},{"k":"c","text":"Ase ei laukea silloin lainkaan"},{"k":"d","text":"Osumakuviosta tulee paljon liian tiivis"}],"correct":"b","explain":"Ilman supistajaa kierteet ovat esillä, ja haulit ja välitulppa voivat vahingoittaa niitä."},{"k":"chokes-pattern-testing-and-care-q2","q":"Millä klassisella etäisyydellä supistajan osumakuvio arvioidaan?","options":[{"k":"a","text":"5 m (noin 5½ jaardia)"},{"k":"b","text":"15 m (noin 16 jaardia)"},{"k":"c","text":"35 m tai 40 jaardia (noin 37 m)"},{"k":"d","text":"80 m (noin 87 jaardia)"}],"correct":"c","explain":"Haulien osuus 75–76 cm:n ympyrässä lasketaan klassisesti 35 m:n tai 40 jaardin etäisyydeltä."},{"k":"chokes-pattern-testing-and-care-q3","q":"Montako laukausta kannattaa ampua osumakuvion arvioimiseksi?","options":[{"k":"a","text":"Vähintään 3–5 joka yhdistelmälle"},{"k":"b","text":"Yksi laukaus riittää tähän"},{"k":"c","text":"Tarkalleen kaksi, yksi per piippu"},{"k":"d","text":"Sata, samana päivänä"}],"correct":"a","explain":"Osumakuviot vaihtelevat laukauksesta toiseen, niin joka ase-, supistaja- ja patruunayhdistelmälle tarvitaan sarja."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"koeammuntalevy","label":"Pattern plate (koeammuntalevy)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"osumakuvio","label":"Pattern (osumakuvio)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/pattern/"},{"id":"choke","en":"Choke","local":"supistaja","label":"Choke (supistaja)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"vaihtosupistajat","label":"Multichoke (vaihtosupistajat)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"supistaja-avain","label":"Choke key (supistaja-avain)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"supistajarasva","label":"Choke grease (supistajarasva)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"aseen sopivuus","label":"Gun fit (aseen sopivuus)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"välitulppa","label":"Wad (välitulppa)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"sylinteri","label":"Cylinder (sylinteri)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"parannettu sylinteri","label":"Improved cylinder (parannettu sylinteri)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"puolisuppea","label":"Modified (puolisuppea)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"3/4-suppea","label":"Improved modified (3/4-suppea)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"täyssuppea","label":"Full choke (täyssuppea)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
