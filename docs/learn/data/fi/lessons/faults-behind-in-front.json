5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"332.1\" cy=\"50.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"348.9\" cy=\"98.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"292.6\" cy=\"67.4\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"368.0\" cy=\"49.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"326.9\" cy=\"85.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"321.2\" cy=\"57.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"354.4\" cy=\"82.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"299.5\" cy=\"86.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"347.0\" cy=\"37.8\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"344.0\" cy=\"118.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"317.9\" cy=\"67.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"350.5\" cy=\"69.5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"313.9\" cy=\"96.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"325.5\" cy=\"39.3\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"362.1\" cy=\"101.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"281.0\" cy=\"76.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"341.3\" cy=\"62.7\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"328.9\" cy=\"97.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"310.8\" cy=\"51.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"366.7\" cy=\"79.0\" r=\"2.2\"/><circle class=\"dg-pat\" cx=\"330\" cy=\"306\" r=\"52\"/><circle class=\"dg-sh\" cx=\"340.0\" cy=\"306.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"317.5\" cy=\"317.5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"332.1\" cy=\"282.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"348.9\" cy=\"330.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"292.6\" cy=\"299.4\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"368.0\" cy=\"281.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"326.9\" cy=\"317.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"321.2\" cy=\"289.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"354.4\" cy=\"314.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"299.5\" cy=\"318.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"347.0\" cy=\"269.8\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"344.0\" cy=\"350.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"317.9\" cy=\"299.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"350.5\" cy=\"301.5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"313.9\" cy=\"328.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"325.5\" cy=\"271.3\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"362.1\" cy=\"333.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"281.0\" cy=\"308.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"341.3\" cy=\"294.7\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"328.9\" cy=\"329.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"310.8\" cy=\"283.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"366.7\" cy=\"311.0\" r=\"2.2\"/>\n<ellipse class=\"dg-tg\" cx=\"330\" cy=\"190\" rx=\"16\" ry=\"6\"/>\n<rect class=\"dg-inset\" x=\"540\" y=\"262\" width=\"124\" height=\"104\" rx=\"8\"/><circle class=\"dg-pat\" cx=\"585\" cy=\"328\" r=\"34\"/><ellipse class=\"dg-tg\" cx=\"612\" cy=\"298\" rx=\"14\" ry=\"5\"/><path class=\"dg-tg\" d=\"M624 290 l8 -6 2 5z\"/><g class=\"dg-n\"><circle cx=\"160\" cy=\"160\" r=\"14\"/><text x=\"160\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"500\" cy=\"160\" r=\"14\"/><text x=\"500\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"40\" r=\"14\"/><text x=\"300\" y=\"40\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"288\" cy=\"330\" r=\"14\"/><text x=\"288\" y=\"330\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"628\" cy=\"290\" r=\"14\"/><text x=\"628\" y=\"290\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Taakse: liian vähän ennakkoa tai ase hidastui</li><li><b aria-hidden=\"true\">2</b>Eteen: liikaa ennakkoa</li><li><b aria-hidden=\"true\">3</b>Yli: usein pää nousi tukilta</li><li><b aria-hidden=\"true\">4</b>Ali: kiekko oli vielä nousussa</li><li><b aria-hidden=\"true\">5</b>Hipaisu: osumakuvion reuna osui; näkyvä pala on osuma</li></ol><figcaption>Kiekko lentää oikealle. Jokainen ympyrä on osumakuvio, hauliparvi. Taakse tarkoittaa sitä puolta, josta kiekko tuli.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"faults-behind-in-front-p2","t":"p","html":"Behind (takana) tarkoittaa, että laukaus meni liikkuvan kiekon taakse: liian vähän <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/lead/\"><span lang=\"en\">lead</span> (ennakkoa)</a> tai hidastunut ase. Se on yleisin ohilaukaus sivukiekoissa. In front (edessä) on päinvastainen: liikaa ennakkoa, usein sen jälkeen, kun ampuja on ylikorjannut. Monet valmentajat pitävät edestä menneestä ohilaukauksesta: se osoittaa, että ase pysyi liikkeessä.","disc":null,"rule_ref":null},{"k":"faults-behind-in-front-p3","t":"p","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/miss-over/\"><span lang=\"en\">Over</span> (yli)</a> – myös ”high”, ”over the top” – ja <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/miss-under/\"><span lang=\"en\">under</span> (ali)</a> – myös ”low” – kuvaavat pystysuuntaista ohilaukausta. Yli on yleinen laskevissa kiekoissa, jäniskiekoissa ja vastakiekoissa, ja se liittyy usein siihen, että pää nousee tukilta. Ali on tyypillinen nousevissa kiekoissa, jotka nousevat vielä laukaushetkellä.","disc":null,"rule_ref":null},{"k":"faults-behind-in-front-p4","t":"p","html":"Chipped (sirpale irti) tarkoittaa, että kiekosta irtosi vain pieni pala. Valmentajalle se on puoliksi kehu, puoliksi korjaus: kiekko jäi <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/pattern/\"><span lang=\"en\">pattern</span> (osumakuvion)</a> reunalle, hauliparven reunaan. Tuomarille se on osuma, kunhan pala on näkyvä. Varo yhtä sääntöjen yksityiskohtaa. Kiekko, joka hajoaa, vaikka se muuttuisi kokonaan tai osittain pölyksi, on osuma molemmissa lajeissa. Kiekko, joka lentää eteenpäin ehjänä ja antaa vain pölyn tai savun pöllähdyksen, ilman <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/visible-piece/\"><span lang=\"en\">visible piece</span> (näkyvää palaa)</a>, on <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/zero/\"><span lang=\"en\">Zero</span> (ohilaukaus)</a>. Valmentajien slangissa ”smoked it” tarkoittaa täydellistä, keskitettyä osumaa, joka muuttaa kiekon pölyksi, ja ”dusted it” kuullaan kummassakin merkityksessä, niin kysy, kun olet epävarma.","disc":"both","rule_ref":null},{"k":"technique-follow-through-and-mistakes-p5","t":"tip","html":"Monet näistä ohilaukauksista on helppo nähdä ulkopuolelta. Takana seisova valmentaja näkee, mihin laukaus meni ja mitä pääsi, kädet ja jalat tekivät. Yksin saattaa korjata väärää asiaa: pysähtyneestä aseesta johtuvaa taakse menevää laukausta ei paranna lisäennakko.","disc":null,"rule_ref":null}],"notes":[{"k":"faults-behind-in-front-n1","for":"interpreter","html":"Välitä suunta heti: ampuja valmistautuu jo seuraavaan kiekkoon."},{"k":"faults-behind-in-front-p5","for":"interpreter","html":"Säilytä valmentajan järjestys: suunta, syy, korjaus. Jos valmentaja sanoo ”behind, you stopped”, syy on tärkeämpi: ampuja, joka kuulee vain ”behind”, lisää ennakkoa, mikä ei korjaa pysähtynyttä asetta."}],"phrases":[{"k":"faults-behind-in-front-ph1","speaker":"coach","en":"Behind, give it more.","meaning":"Laukaus meni kiekon taakse; lisää ennakkoa.","say":"Takana, anna lisää.","audio":1},{"k":"faults-behind-in-front-ph2","speaker":"coach","en":"Just over the top, it was already dropping.","meaning":"Laukaus meni yli, koska kiekko oli jo laskemassa; ammu alemmas ja eteen.","say":"Juuri yli, se oli jo laskemassa.","audio":1},{"k":"faults-behind-in-front-ph3","speaker":"coach","en":"In front this time, good, now a touch less.","meaning":"Liikaa ennakkoa, mutta ase liikkui; vähennä ennakkoa hieman.","say":"Tällä kertaa edessä, hyvä, nyt hitusen vähemmän.","audio":1},{"k":"faults-behind-in-front-ph4","speaker":"coach","en":"You just chipped it, a little more in front.","meaning":"Osuma osumakuvion reunalla; vähän lisää ennakkoa keskittää sen.","say":"Sait siitä vain sirpaleen, vähän enemmän eteen.","audio":1},{"k":"faults-behind-in-front-ph5","speaker":"coach","en":"Smoked it! Same again.","meaning":"Täydellinen keskitetty osuma (slangia, ei sääntöjen ”savu”); toista täsmälleen samoin.","say":"Pölyksi! Samoin uudestaan.","audio":1},{"k":"faults-behind-in-front-ph6","speaker":"coach","en":"Behind, but you stopped, so don't just add lead.","meaning":"Syy on pysähtynyt ase; pelkkä lisäennakko ei auta.","say":"Takana, mutta pysäytit, joten älä vain lisää ennakkoa.","audio":1}],"key_points":[{"k":"faults-behind-in-front-kp1","html":"Valmentaja nimeää suunnan ensin: takana, edessä, yli, ali.","checklist":false},{"k":"faults-behind-in-front-kp2","html":"Takana = liian vähän ennakkoa tai hidastuva ase; edessä = liikaa ennakkoa.","checklist":false},{"k":"faults-behind-in-front-kp3","html":"Näkyvä sirpale, tai pölyksi muuttunut kiekko, on osuma; ehjä kiekko, josta tulee vain pölyä tai savua, on <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/fi/glossary/zero/\"><span lang=\"en\">Zero</span></a>.","checklist":false},{"k":"faults-behind-in-front-kp4","html":"”Smoked it” on valmentajan kehu, ei sääntöjen ”savu”: älä sekoita niitä.","checklist":false},{"k":"faults-behind-in-front-kp5","html":"Korjaa syy, ei vain suuntaa: lisäennakko ei paranna pysähtynyttä asetta.","checklist":false}],"did_you_know":{"k":"technique-follow-through-and-mistakes-dyk","html":"Valmentaja seisoo usein hieman ampujan takana ja sivussa. Sieltä on helpompi nähdä laukauksen jälki ilmassa ja missä se ohitti kiekon."},"quiz":[{"k":"faults-behind-in-front-q1","q":"Valmentaja huutaa: ”Behind, you stopped!” Mikä on tärkeintä seuraavaa laukausta varten?","options":[{"k":"a","text":"Syy: ase pysähtyi"},{"k":"b","text":"Vain suunta ”behind”"},{"k":"c","text":"Ei mitään: ampuja näki ohilaukauksen itse"},{"k":"d","text":"Pyyntö lisätä paljon ennakkoa"}],"correct":"a","explain":"Ennakon lisääminen ei korjaa pysähtynyttä asetta; syy on se, mikä ampujan täytyy korjata."},{"k":"faults-behind-in-front-q2","q":"Kiekosta irtoaa pieni mutta selvästi näkyvä pala. Valmentaja sanoo ”just chipped it”. Miten tuomari merkitsee sen?","options":[{"k":"a","text":"Ohi, koska suurin osa kiekosta lensi eteenpäin"},{"k":"b","text":"Uusi kiekko"},{"k":"c","text":"Osuma"},{"k":"d","text":"Osuma vain, jos valmentaja on samaa mieltä"}],"correct":"c","explain":"Vähintään yksi näkyvä pala tekee kiekosta osuman sekä Sporting™- että Compak® Sporting-lajissa; tuomari päättää yksin.","rule_ref":"sporting:ch6-target-one","disc":"both"},{"k":"faults-behind-in-front-q3","q":"Osuman jälkeen valmentaja huudahtaa ”Smoked it!”. Mitä hän tarkoittaa?","options":[{"k":"a","text":"Kiekosta irtosi vain pölyä, niin se on ohi"},{"k":"b","text":"Täydellinen, keskitetty osuma"},{"k":"c","text":"Se oli pölykiekko"},{"k":"d","text":"Ampujan pitäisi vaihtaa patruunoita"}],"correct":"b","explain":"Valmentajien slangissa ”smoked it” on kehu pölyksi ammutusta kiekosta; säännöissä pöly tai savu ilman näkyvää palaa on ohilaukaus."}],"terms":[{"id":"lead","en":"Lead","local":"ennakko","label":"Lead (ennakko)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/lead/"},{"id":"crosser","en":"Crosser","local":"sivukiekko","label":"Crosser (sivukiekko)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/crosser/"},{"id":"dropping-target","en":"Dropping target","local":"laskeva kiekko","label":"Dropping target (laskeva kiekko)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/dropping-target/"},{"id":"visible-piece","en":"Visible piece","local":"näkyvä pala","label":"Visible piece (näkyvä pala)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/visible-piece/"},{"id":"one","en":"One","local":"osuma","label":"One (osuma)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/one/"},{"id":"zero","en":"Zero","local":"ohi","label":"Zero (ohi)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/zero/"},{"id":"miss-behind","en":"Behind","local":"taakse","label":"Behind (taakse)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/miss-behind/"},{"id":"miss-in-front","en":"In front","local":"eteen","label":"In front (eteen)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/miss-in-front/"},{"id":"miss-over","en":"Over","local":"yli","label":"Over (yli)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/miss-over/"},{"id":"miss-under","en":"Under","local":"ali","label":"Under (ali)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/miss-under/"},{"id":"chip","en":"Chip","local":"pieni pala","label":"Chip (pieni pala)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/chip/"},{"id":"smoked-it","en":"Smoked it","local":"pölyksi","label":"Smoked it (pölyksi)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/smoked-it/"},{"id":"pattern","en":"Pattern","local":"osumakuvio","label":"Pattern (osumakuvio)","url":"https://juliabezdolna.github.io/clayaway/fi/glossary/pattern/"}],"rule_refs":[{"book":"sporting","id":"ch6-target-one","label":"Luku 6","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/target-refereeing/?lang=fi#ch6-target-one"},{"book":"sporting","id":"ch6-target-zero","label":"Luku 6","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/target-refereeing/?lang=fi#ch6-target-zero"},{"book":"compak","id":"ch20-one","label":"Luku 20","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/judging-targets/?lang=fi#ch20-one"},{"book":"compak","id":"ch20-zero","label":"Luku 20","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/judging-targets/?lang=fi#ch20-zero"}],"sources":[{"title":"FITASC — rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true}],"evidence":[],"more_in_en":0}
