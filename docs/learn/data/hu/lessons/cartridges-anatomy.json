\"dg-c6\" cx=\"329.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">kilőtt hüvely: általában 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Hüvely (műanyag vagy papír)</li><li><b aria-hidden=\"true\">2</b>Fém fenék</li><li><b aria-hidden=\"true\">3</b>Csappantyú</li><li><b aria-hidden=\"true\">4</b>Lőpor</li><li><b aria-hidden=\"true\">5</b>Fojtás</li><li><b aria-hidden=\"true\">6</b>Sörét</li><li><b aria-hidden=\"true\">7</b>Peremezés (csillagzárás, 6 vagy 8 hajtás)</li></ol><figcaption>Mi van egy lőszerben, a fém fenéktől a peremezésig.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"A <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/hull/\"><span lang=\"en\">hull</span></a> (angolul case is) egy cső, leggyakrabban műanyag, fém fenékkel alul. Papírhüvelyek is léteznek, és néhány lőtér ezeket részesíti előnyben, mert kevesebb szemetet hagynak. Egy kilőtt hüvely rendszerint 65–70 mm hosszú, és illenie kell a fegyvered <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/chamber/\"><span lang=\"en\">chamber</span> (tölténykamrájához)</a> – lásd: <a href=\"https://juliabezdolna.github.io/clayaway/hu/learn/gun-gauge-and-barrels/\">Kaliber és csőhossz</a>.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"A fenék közepén ül a csappantyú. Amikor az ütőszeg ráüt, a csappantyú szikrát ad, és meggyújtja a lőport. A lőpor nem robban, hanem nagyon gyorsan ég el, és a gázok előretolják a sörétterhet a csövön.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"A lőpor és a sörét között ül a fojtás. Dugóként működik: megakadályozza, hogy a forró gáz elfújja a szemek mellett, párnázza a lökést, és összetartja a szemeket, miközben a csövön haladnak. Egy műanyag fojtásnak rendszerint van egy „csészéje”, amely védi a szemeket, és gyakran kicsit szűkebb <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/pattern/\"><span lang=\"en\">pattern</span> (sörétképet)</a> ad.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"Egy <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/fibre-wad/\"><span lang=\"en\">fibre wad</span> (rostfojtás vagy filcfojtás)</a> lebomlik a természetben, ezért sok lőtér ezt kéri. Léteznek lebomló műanyag fojtások is, de néhány lőtér nem fogadja el őket.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"A fojtás fölött van a sörét: több száz apró szem. A hüvely tetejét a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/crimp/\"><span lang=\"en\">crimp</span> (peremezés)</a> zárja le, leggyakrabban egy 6 vagy 8 hajtású csillag. Egy jó peremezés szilárdan a helyén tart mindent, és segít, hogy minden töltény ugyanúgy süljön el, mint az előző.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"A Parcours de Chasse – Sporting™ és a Compak® Sporting FITASC szabályai tiltják a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/reloaded-cartridge/\"><span lang=\"en\">reloaded cartridge</span> (újratöltött töltényeket)</a>, azaz a kilőtt, majd újra megtöltött hüvelyeket, például otthon. Tiltják a szórókat (olyan betéteket, amelyek szándékosan szélesebbre szórják a sörétet) és bármilyen más különleges eszközt a töltény belsejében is. Tilos a vegyes méretű vagy minőségű sörét, a fekete lőpor és a nyomjelzők (olyan töltények, amelyek izzó nyomot hagynak) is. Tehát versenyre hozz gyári, a szabályoknak megfelelő töltényeket.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"A dobozon rendszerint fel van tüntetve a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/gauge/\"><span lang=\"en\">gauge</span> (kaliber)</a>, a hüvelyhossz, a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/load-weight/\"><span lang=\"en\">load weight</span> (töltetsúly)</a>, a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/shot-size/\"><span lang=\"en\">shot size</span> (sörétszám)</a> vagy a sörétátmérő, a sörét anyaga és a fojtás típusa, és gyakran a sebesség is. Tanuld meg kiolvasni a dobozt, és tudni fogod, mit töltesz.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Néhány lőtér saját környezetvédelmi szabályokat ad hozzá edzéshez, például csak rostfojtás vagy csak <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (acélsörét)</a>: nézd meg a lőtér szabályait egy út előtt. Az üres hüvelyek a lőálláson lévő kukába kerülnek, és a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span> (félautomatával)</a> lövők felszedik a kilökött hüvelyeiket, amikor elmennek.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"A dobozon lévő három számnak saját órája van: a kaliber (<a href=\"https://juliabezdolna.github.io/clayaway/hu/learn/gun-gauge-and-barrels/\">Kaliber és csőhossz</a>), a sörétszám (<a href=\"https://juliabezdolna.github.io/clayaway/hu/learn/cartridges-shot-size/\">Sörétszám</a>) és a töltetsúly (<a href=\"https://juliabezdolna.github.io/clayaway/hu/learn/cartridges-load-weight/\">Töltetsúly</a>).","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"A kilőtt hüvelyeket tedd a gyűjtőbe.","say":"Az üres hüvelyeket a gyűjtőbe, kérlek, ne a fűre.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Ezen a lőtéren lead shot (ólomsörét) nem megengedett (helyi szabály, nem FITASC-szabály).","say":"Ezen a lőtéren csak acélsörét.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Töltény = hüvely, csappantyú, lőpor, fojtás, sörét.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Műanyag fojtás: gyakran kicsit szűkebb sörétkép; rostfojtás: lebomlik a természetben.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"A FITASC tiltja az újratöltött töltényeket, a szórókat, a vegyes sörétet, a fekete lőport és a nyomjelzőket.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Olvasd a dobozt: kaliber, hossz, töltetsúly, sörét, fojtás.","checklist":false},{"k":"gear-cartridges-kp5","html":"Az üres hüvelyek a gyűjtőbe kerülnek; a félautomatával lövők összeszedik a hüvelyeiket.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Lövés után egy műanyag fojtás még több tíz métert repül a lőálláson túl. Ezért a régi lőterek körüli mezők tele lehetnek fojtásokkal, míg a rost fokozatosan lebomlik."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Mi gyújtja meg a lőport egy töltényben?","options":[{"k":"a","text":"A fojtás"},{"k":"b","text":"A csappantyú"},{"k":"c","text":"A peremezés"},{"k":"d","text":"A sörét"}],"correct":"b","explain":"Az ütőszeg ráüt a csappantyúra, az pedig meggyújtja a lőport."},{"k":"cartridges-anatomy-q2","q":"Miért kér sok lőtér rostfojtást?","options":[{"k":"a","text":"Olcsóbbak"},{"k":"b","text":"Szűkebb sörétképet adnak"},{"k":"c","text":"Lebomlanak a természetben"},{"k":"d","text":"A FITASC megköveteli"}],"correct":"c","explain":"A rost és a filc lebomlik, míg a hagyományos műanyag fojtások évekig a mezőkön maradnak."},{"k":"cartridges-anatomy-q3","q":"Milyen töltényeket tiltanak a FITASC szabályai?","options":[{"k":"a","text":"Gyári, műanyag fojtásos töltetek"},{"k":"b","text":"Gyári, rostfojtásos töltetek"},{"k":"c","text":"Papírhüvelyes töltények"},{"k":"d","text":"Újratöltött töltények"}],"correct":"d","explain":"Az újratöltött töltények, a szórók, a vegyes sörét, a fekete lőpor és a nyomjelzők tilosak.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"töltény","label":"Cartridge (töltény)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"hüvely","label":"Hull (hüvely)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/hull/"},{"id":"primer","en":"Primer","local":"csappantyú","label":"Primer (csappantyú)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/primer/"},{"id":"powder","en":"Powder","local":"lőpor","label":"Powder (lőpor)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/powder/"},{"id":"wad","en":"Wad","local":"fojtás","label":"Wad (fojtás)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"rostfojtás","label":"Fibre wad (rostfojtás)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"peremezés","label":"Crimp (peremezés)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"tölténykamra","label":"Chamber (tölténykamra)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"üres hüvelyek","label":"Empty cases (üres hüvelyek)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"félautomata","label":"Semi-automatic (félautomata)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"acélsörét","label":"Steel shot (acélsörét)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"sörétméret","label":"Shot size (sörétméret)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"töltetsúly","label":"Load weight (töltetsúly)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"kaliber","label":"Gauge (kaliber)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Fejezet 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=hu#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Fejezet 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=hu#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Fejezet 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=hu#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Fejezet 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=hu#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
