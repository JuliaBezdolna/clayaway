318.8\" cy=\"166.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"257.9\" cy=\"175.6\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"328.1\" cy=\"105.8\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"322.3\" cy=\"232.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"220.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 yard</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Kb. 1 × 1 m-es papírlap vagy belövőlap</li><li><b aria-hidden=\"true\">2</b>75–76 cm átmérőjű kör a legsűrűbb rész körül</li><li><b aria-hidden=\"true\">3</b>Számolja meg a találatokat a körben, és vesse össze a lőszerben lévő sörétek számával (28 g 7½-es: kb. 350–400)</li><li><b aria-hidden=\"true\">4</b>A szűkület megítéléséhez: 35 m vagy 40 yard (a fegyver illesztéséhez kb. 15 m)</li><li><b aria-hidden=\"true\">5</b>Nagyjából ennyi sörét kerül a körbe</li></ol><figcaption>A százalékok tájékoztató jellegűek, és a lőszertől függnek. Minden szűkület–lőszer párosítással adjon le legalább 3–5 lövést.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"Közelítőleg ezen a távolságon a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (henger)</a> kb. 40%-át teszi a sörétnek a körbe, az improved cylinder kb. 50%-át, a modified kb. 60%-át, az improved modified kb. 65%-át, a full pedig 70% vagy több. Az adatok a tölténytől függenek, tehát a saját fegyvered és töltényed más eredményt adhat.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Egy lövés alig bizonyít valamit: a sörétképek jelentősen eltérnek még azonos töltényekkel is. Lőj le legalább 3–5 lövést minden kombinációra. Figyelj az egyenletességre is: egy jó sörétkép egyenletes, nagy lyukak és egy sűrű középső csomó nélkül.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Lövészet után csavard ki a szűkületeket a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/choke-key/\"><span lang=\"en\">choke key</span> (szűkületkulccsal)</a>.","Tisztítsd meg őket belül és kívül oldattal és kefével, és töröld át a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/muzzle/\"><span lang=\"en\">muzzle</span> (torkolat)</a> menetét.","Mielőtt visszacsavarnád, tegyél egy vékony réteg <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (szűkületzsírt)</a> a menetre: ez megakadályozza a rozsdát, és nem hagyja a szűkületet beragadni."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Minden foglalkozás előtt ellenőrizd, hogy a szűkületek szorosan vannak-e, mert a lövés lassan kilazíthatja őket. Csavard be teljesen a kulccsal, de ne túlzott erővel.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Soha ne lőj egy <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (csere choke)</a> fegyverből szűkület nélkül, vagy egy csak félig becsavart szűkülettel. A sörét és a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/hu/glossary/wad/\"><span lang=\"en\">wad</span> (fojtás)</a> károsíthatja a torkolat menetét, és a javítás drága. Tartsd a tartalék szűkületeket egy külön tartóban, hogy ne vesszenek el.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"A sörétképet egy lapon ellenőrzik: a tusbeállítást kb. 15 m (16 yard), a szűkületet 35 m-en vagy 40 yardon.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Számold a sörét hányadát egy 75–76 cm-es körben; lőj 3–5 lövést.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Tisztítsd meg a szűkületeket lövészet után, és zsírozd a meneteket szűkületzsírral.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Minden foglalkozás előtt ellenőrizd, hogy a szűkületek szorosak-e.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Multichoke fegyverből szűkület nélkül ne lőj.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Minden lövés után a belövőlapot újra lefestik vagy lezsírozzák, egy görgővel vagy kefével, hogy a következő nyomok ne keveredjenek az előzőekkel."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Miért nem szabad egy multichoke fegyverből szűkület nélkül lőni?","options":[{"k":"a","text":"Ez csak versenyeken tilos"},{"k":"b","text":"A sörét és a fojtás károsíthatja a torkolat menetét"},{"k":"c","text":"A fegyver akkor egyáltalán nem sül el"},{"k":"d","text":"A sörétkép túl szűkké válik"}],"correct":"b","explain":"Szűkület nélkül a menet szabadon van, és a sörét és a fojtás károsíthatja."},{"k":"chokes-pattern-testing-and-care-q2","q":"Milyen klasszikus távolságon ítélik meg egy szűkület sörétképét?","options":[{"k":"a","text":"5 m (kb. 5½ yard)"},{"k":"b","text":"15 m (kb. 16 yard)"},{"k":"c","text":"35 m vagy 40 yard (kb. 37 m)"},{"k":"d","text":"80 m (kb. 87 yard)"}],"correct":"c","explain":"A sörét hányadát egy 75–76 cm-es körben klasszikusan 35 m-en vagy 40 yardon számolják."},{"k":"chokes-pattern-testing-and-care-q3","q":"Hány lövést kell leadnod, hogy megítélj egy sörétképet?","options":[{"k":"a","text":"Legalább 3–5-öt minden párosra"},{"k":"b","text":"Egy lövés elég erre"},{"k":"c","text":"Pontosan kettőt, egyet minden csőre"},{"k":"d","text":"Százat, aznap"}],"correct":"a","explain":"A sörétképek lövésről lövésre eltérnek, tehát minden fegyver-szűkület-töltény pároshoz egy sorozat kell."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"belövőlap","label":"Pattern plate (belövőlap)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"sörétkép","label":"Pattern (sörétkép)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/pattern/"},{"id":"choke","en":"Choke","local":"szűkület","label":"Choke (szűkület)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"csere choke","label":"Multichoke (csere choke)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"choke kulcs","label":"Choke key (choke kulcs)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"choke zsír","label":"Choke grease (choke zsír)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"tusméret beállítása","label":"Gun fit (tusméret beállítása)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"fojtás","label":"Wad (fojtás)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"henger","label":"Cylinder (henger)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"negyedes","label":"Improved cylinder (negyedes)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"feles","label":"Modified (feles)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"háromnegyedes","label":"Improved modified (háromnegyedes)","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"","label":"Full choke","url":"https://juliabezdolna.github.io/clayaway/hu/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
