"348.9\" cy=\"98.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"292.6\" cy=\"67.4\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"368.0\" cy=\"49.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"326.9\" cy=\"85.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"321.2\" cy=\"57.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"354.4\" cy=\"82.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"299.5\" cy=\"86.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"347.0\" cy=\"37.8\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"344.0\" cy=\"118.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"317.9\" cy=\"67.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"350.5\" cy=\"69.5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"313.9\" cy=\"96.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"325.5\" cy=\"39.3\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"362.1\" cy=\"101.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"281.0\" cy=\"76.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"341.3\" cy=\"62.7\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"328.9\" cy=\"97.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"310.8\" cy=\"51.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"366.7\" cy=\"79.0\" r=\"2.2\"/><circle class=\"dg-pat\" cx=\"330\" cy=\"306\" r=\"52\"/><circle class=\"dg-sh\" cx=\"340.0\" cy=\"306.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"317.5\" cy=\"317.5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"332.1\" cy=\"282.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"348.9\" cy=\"330.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"292.6\" cy=\"299.4\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"368.0\" cy=\"281.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"326.9\" cy=\"317.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"321.2\" cy=\"289.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"354.4\" cy=\"314.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"299.5\" cy=\"318.6\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"347.0\" cy=\"269.8\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"344.0\" cy=\"350.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"317.9\" cy=\"299.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"350.5\" cy=\"301.5\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"313.9\" cy=\"328.9\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"325.5\" cy=\"271.3\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"362.1\" cy=\"333.1\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"281.0\" cy=\"308.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"341.3\" cy=\"294.7\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"328.9\" cy=\"329.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"310.8\" cy=\"283.0\" r=\"2.2\"/><circle class=\"dg-sh\" cx=\"366.7\" cy=\"311.0\" r=\"2.2\"/>\n<ellipse class=\"dg-tg\" cx=\"330\" cy=\"190\" rx=\"16\" ry=\"6\"/>\n<rect class=\"dg-inset\" x=\"540\" y=\"262\" width=\"124\" height=\"104\" rx=\"8\"/><circle class=\"dg-pat\" cx=\"585\" cy=\"328\" r=\"34\"/><ellipse class=\"dg-tg\" cx=\"612\" cy=\"298\" rx=\"14\" ry=\"5\"/><path class=\"dg-tg\" d=\"M624 290 l8 -6 2 5z\"/><g class=\"dg-n\"><circle cx=\"160\" cy=\"160\" r=\"14\"/><text x=\"160\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"500\" cy=\"160\" r=\"14\"/><text x=\"500\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"40\" r=\"14\"/><text x=\"300\" y=\"40\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"288\" cy=\"330\" r=\"14\"/><text x=\"288\" y=\"330\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"628\" cy=\"290\" r=\"14\"/><text x=\"628\" y=\"290\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Za terčem: málo předsazení, nebo zbraň zpomalila</li><li><b aria-hidden=\"true\">2</b>Před terčem: příliš velké předsazení</li><li><b aria-hidden=\"true\">3</b>Nad: často se hlava zvedla z pažby</li><li><b aria-hidden=\"true\">4</b>Pod: terč ještě stoupal</li><li><b aria-hidden=\"true\">5</b>Škrábnutý: zasažen okrajem obrazce; viditelný úlomek je zásah</li></ol><figcaption>Terč letí doprava. Každý kruh je obrazec zásahu, mrak broků. Za je strana, odkud terč přiletěl.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"faults-behind-in-front-p2","t":"p","html":"Behind („za terčem“) znamená, že rána prošla za letícím terčem: chybělo <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/lead/\"><span lang=\"en\">lead</span> (předsazení)</a>, nebo zbraň zpomalila. Je to velmi častá chyba na přeletových terčích. In front („před terčem“) je opak: příliš velké předsazení, často po přehnané opravě. Mnozí trenéři mají chybu před terčem rádi: ukazuje, že zbraň zůstala v pohybu.","disc":null,"rule_ref":null},{"k":"faults-behind-in-front-p3","t":"p","html":"Over (také „high“, „over the top“ – nad terčem) a under („low“ – pod terčem) popisují svislou chybu. Nad terčem je časté u <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/dropping-target/\"><span lang=\"en\">dropping target</span> (padajících terčů)</a>, zajíců a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/incomer/\"><span lang=\"en\">incomer</span> (příletových terčů)</a> a často souvisí se zvednutím hlavy ze <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/stock/\"><span lang=\"en\">stock</span> (pažby)</a>. Pod terčem je typické u <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/springing-target/\"><span lang=\"en\">springing target</span> (stoupajících terčů)</a>, které v okamžiku výstřelu ještě stoupají.","disc":null,"rule_ref":null},{"k":"faults-behind-in-front-p4","t":"p","html":"Chipped („škrtnutý“) znamená, že se odlomil jen malý kousek. Pro trenéra je to napůl pochvala, napůl oprava: terč zachytil okraj <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/pattern/\"><span lang=\"en\">pattern</span> (obrazce zásahu)</a>, mraku broků. Pro rozhodčího je to zásah, pokud je úlomek vidět. Tady je jeden detail pravidel, na který pozor: terč, který se rozbije – i kdyby se celý nebo zčásti proměnil v prach –, je zásah v obou disciplínách. Terč, který letí dál vcelku a vypustí jen obláček prachu nebo dýmu, bez jakéhokoli viditelného úlomku, je <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/zero/\"><span lang=\"en\">Zero</span> (chyba)</a>. V tréninkovém slangu „smoked it“ znamená dokonalý, středový zásah, při kterém se terč rozpadne na prach, a „dusted it“ se používá v obou významech, takže když si nejste jistí, zeptejte se.","disc":"both","rule_ref":null},{"k":"technique-follow-through-and-mistakes-p5","t":"tip","html":"Mnohé z těchto chyb jsou zvenčí dobře vidět. Trenér, který stojí za vámi, vidí, kam šla rána a co dělaly vaše hlava, ruce i nohy. Sami si ale můžete opravit tu nesprávnou věc: chybu za terčem ze zastavené zbraně větší předsazení nevyléčí.","disc":null,"rule_ref":null}],"notes":[{"k":"faults-behind-in-front-n1","for":"interpreter","html":"Předejte směr okamžitě: střelec se už připravuje na další terč."},{"k":"faults-behind-in-front-p5","for":"interpreter","html":"Dodržte trenérovo pořadí: směr, příčina, náprava. Když trenér řekne „behind, you stopped“, důležitější je příčina: střelec, který uslyší jen „za terčem“, přidá předsazení, a to zastavenou zbraň nevyléčí."}],"phrases":[{"k":"faults-behind-in-front-ph1","speaker":"coach","en":"Behind, give it more.","meaning":"Rána prošla za terčem; zvětšete předsazení.","say":"Za ním, dejte víc.","audio":1},{"k":"faults-behind-in-front-ph2","speaker":"coach","en":"Just over the top, it was already dropping.","meaning":"Rána šla nad, protože terč už padal; střílejte níž a před něj.","say":"Těsně nad, už padal.","audio":1},{"k":"faults-behind-in-front-ph3","speaker":"coach","en":"In front this time, good, now a touch less.","meaning":"Příliš předsazení, ale zbraň byla v pohybu; předsazení mírně zmenšete.","say":"Tentokrát před ním, dobře, teď o kousek míň.","audio":1},{"k":"faults-behind-in-front-ph4","speaker":"coach","en":"You just chipped it, a little more in front.","meaning":"Zásah okrajem obrazce; o něco víc předsazení ho vystředí.","say":"Jen jste ho škrtl, trochu víc dopředu.","audio":1},{"k":"faults-behind-in-front-ph5","speaker":"coach","en":"Smoked it! Same again.","meaning":"Dokonalý středový zásah (slang, ne „kouř“ z pravidel); přesně zopakujte.","say":"Rozprášil jste ho! Ještě jednou stejně.","audio":1},{"k":"faults-behind-in-front-ph6","speaker":"coach","en":"Behind, but you stopped, so don't just add lead.","meaning":"Příčinou je zastavená zbraň; samotné větší předsazení nepomůže.","say":"Za ním, ale zastavil jste, takže jen nepřidávejte předsazení.","audio":1}],"key_points":[{"k":"faults-behind-in-front-kp1","html":"Trenér nejdřív pojmenuje směr: za terčem, před terčem, nad, pod.","checklist":false},{"k":"faults-behind-in-front-kp2","html":"Za terčem = málo předsazení nebo zpomalující zbraň; před terčem = příliš předsazení.","checklist":false},{"k":"faults-behind-in-front-kp3","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/visible-piece/\"><span lang=\"en\">Visible piece</span> (viditelný úlomek)</a>, nebo terč rozbitý na prach, je zásah; celý terč, který vypustí jen prach nebo dým, je <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/zero/\"><span lang=\"en\">Zero</span></a>.","checklist":false},{"k":"faults-behind-in-front-kp4","html":"„Smoked it“ je pochvala trenéra, ne „dým“ z pravidel: nezaměňujte je.","checklist":false},{"k":"faults-behind-in-front-kp5","html":"Opravujte příčinu, ne jen směr: víc předsazení nevyléčí zastavenou zbraň.","checklist":false}],"did_you_know":{"k":"technique-follow-through-and-mistakes-dyk","html":"Trenér často stojí trochu za střelcem a stranou od něj. Odtamtud je lépe vidět stopu rány ve vzduchu a místo, kde minula terč."},"quiz":[{"k":"faults-behind-in-front-q1","q":"Trenér volá: „Behind, you stopped!“ Co je pro další výstřel nejdůležitější?","options":[{"k":"a","text":"Příčina: zbraň se zastavila"},{"k":"b","text":"Jen směr „za terčem“"},{"k":"c","text":"Nic: chybu jste viděli sami"},{"k":"d","text":"Pokyn přidat mnohem víc předsazení"}],"correct":"a","explain":"Přidané předsazení nevyléčí zastavenou zbraň; opravit je třeba příčinu."},{"k":"faults-behind-in-front-q2","q":"Od terče se odlomí malý, ale jasně visible piece (viditelný kousek). Trenér řekne „just chipped it“. Jak to ohodnotí rozhodčí?","options":[{"k":"a","text":"Chyba, protože většina terče letěla dál"},{"k":"b","text":"No Bird"},{"k":"c","text":"One"},{"k":"d","text":"Zásah, jen pokud souhlasí trenér"}],"correct":"c","explain":"Alespoň jeden viditelný úlomek znamená zásah ve Sporting™ i Compak® Sporting; rozhoduje jen rozhodčí.","rule_ref":"sporting:ch6-target-one","disc":"both"},{"k":"faults-behind-in-front-q3","q":"Po zásahu trenér zvolá „Smoked it!“. Co tím myslí?","options":[{"k":"a","text":"Zvedl se jen prach, takže je to chyba"},{"k":"b","text":"Dokonalý, středový zásah"},{"k":"c","text":"Byl to terč flash"},{"k":"d","text":"Střelec by měl vyměnit náboje"}],"correct":"b","explain":"V tréninkovém slangu je „smoked it“ pochvala za terč rozbitý na prach, a i pravidla to počítají jako zásah. Chybou (zero) je jen celý terč, který vypustí obláček prachu nebo dýmu bez viditelného úlomku."}],"terms":[{"id":"lead","en":"Lead","local":"předsazení","label":"Lead (předsazení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/lead/"},{"id":"crosser","en":"Crosser","local":"přeletový terč","label":"Crosser (přeletový terč)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/crosser/"},{"id":"dropping-target","en":"Dropping target","local":"padající terč","label":"Dropping target (padající terč)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/dropping-target/"},{"id":"visible-piece","en":"Visible piece","local":"viditelný úlomek","label":"Visible piece (viditelný úlomek)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/visible-piece/"},{"id":"one","en":"One","local":"zásah","label":"One (zásah)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/one/"},{"id":"zero","en":"Zero","local":"nula","label":"Zero (nula)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/zero/"},{"id":"miss-behind","en":"Behind","local":"za terčem","label":"Behind (za terčem)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/miss-behind/"},{"id":"miss-in-front","en":"In front","local":"před terčem","label":"In front (před terčem)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/miss-in-front/"},{"id":"miss-over","en":"Over","local":"nad terčem","label":"Over (nad terčem)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/miss-over/"},{"id":"miss-under","en":"Under","local":"pod terčem","label":"Under (pod terčem)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/miss-under/"},{"id":"chip","en":"Chip","local":"ťuknutý terč","label":"Chip (ťuknutý terč)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/chip/"},{"id":"smoked-it","en":"Smoked it","local":"rozprášený terč","label":"Smoked it (rozprášený terč)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/smoked-it/"},{"id":"pattern","en":"Pattern","local":"obrazec zásahu","label":"Pattern (obrazec zásahu)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/pattern/"}],"rule_refs":[{"book":"sporting","id":"ch6-target-one","label":"Kapitola 6","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/target-refereeing/?lang=cs#ch6-target-one"},{"book":"sporting","id":"ch6-target-zero","label":"Kapitola 6","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/target-refereeing/?lang=cs#ch6-target-zero"},{"book":"compak","id":"ch20-one","label":"Kapitola 20","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/judging-targets/?lang=cs#ch20-one"},{"book":"compak","id":"ch20-zero","label":"Kapitola 20","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/judging-targets/?lang=cs#ch20-zero"}],"sources":[{"title":"FITASC — rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true}],"evidence":[],"more_in_en":0}
