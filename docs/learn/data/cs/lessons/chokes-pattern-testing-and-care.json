232.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"220.3\" cy=\"114.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"331.2\" cy=\"154.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"268.6\" cy=\"200.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"292.3\" cy=\"93.7\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"364.0\" cy=\"213.2\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"286.9\" cy=\"160.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"329.8\" cy=\"132.9\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"296.1\" cy=\"217.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"252.2\" cy=\"103.4\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"389.6\" cy=\"173.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"277.8\" cy=\"174.1\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"311.8\" cy=\"114.3\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"332.3\" cy=\"216.0\" r=\"1.9\"/><circle class=\"dg-hole\" cx=\"222.0\" cy=\"134.8\" r=\"1.9\"/>\n<circle class=\"dg-ring\" cx=\"300\" cy=\"160\" r=\"83\"/>\n<g class=\"dg-dm\"><text x=\"125\" y=\"160\" text-anchor=\"middle\">35 m / 40 yardů</text></g>\n<text class=\"dg-nm\" x=\"500\" y=\"102\" text-anchor=\"end\">Cyl</text><rect class=\"dg-bar0\" x=\"510\" y=\"86\" width=\"64\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"580\" y=\"101\">40%</text><text class=\"dg-nm\" x=\"500\" y=\"140\" text-anchor=\"end\">IC</text><rect class=\"dg-bar1\" x=\"510\" y=\"124\" width=\"80\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"596\" y=\"139\">50%</text><text class=\"dg-nm\" x=\"500\" y=\"178\" text-anchor=\"end\">M</text><rect class=\"dg-bar3\" x=\"510\" y=\"162\" width=\"96\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"612\" y=\"177\">60%</text><text class=\"dg-nm\" x=\"500\" y=\"216\" text-anchor=\"end\">IM</text><rect class=\"dg-bar4\" x=\"510\" y=\"200\" width=\"104\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"620\" y=\"215\">65%</text><text class=\"dg-nm\" x=\"500\" y=\"254\" text-anchor=\"end\">Full</text><rect class=\"dg-bar5\" x=\"510\" y=\"238\" width=\"112\" height=\"20\" rx=\"3\"/><text class=\"dg-val\" x=\"628\" y=\"253\">70%+</text><g class=\"dg-n\"><circle cx=\"196\" cy=\"78\" r=\"14\"/><text x=\"196\" y=\"78\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><path class=\"dg-ld\" d=\"M380 230L359 218\"/><circle class=\"dg-ldd\" cx=\"359\" cy=\"218\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"380\" cy=\"230\" r=\"14\"/><text x=\"380\" y=\"230\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"300\" cy=\"160\" r=\"14\"/><text x=\"300\" y=\"160\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><path class=\"dg-ld\" d=\"M125 196L125 172\"/><circle class=\"dg-ldd\" cx=\"125\" cy=\"172\" r=\"3\"/><g class=\"dg-n\"><circle cx=\"125\" cy=\"196\" r=\"14\"/><text x=\"125\" y=\"196\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"560\" cy=\"58\" r=\"14\"/><text x=\"560\" y=\"58\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Arch papíru asi 1 × 1 m nebo nástřelná deska</li><li><b aria-hidden=\"true\">2</b>Kruh o průměru 75–76 cm kolem nejhustší části</li><li><b aria-hidden=\"true\">3</b>Spočítejte zásahy uvnitř a porovnejte s počtem broků v náboji (28 g č. 7½: asi 350–400)</li><li><b aria-hidden=\"true\">4</b>Pro posouzení zahrdlení: 35 m nebo 40 yardů (pro přizpůsobení zbraně asi 15 m)</li><li><b aria-hidden=\"true\">5</b>Přibližný podíl broků v kruhu</li></ol><figcaption>Procenta jsou orientační a závisí na náboji. Na každou kombinaci zahrdlení a náboje vystřelte aspoň 3–5 ran.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p3","t":"p","html":"Orientačně na tuto vzdálenost dá <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/cylinder/\"><span lang=\"en\">cylinder</span> (válec)</a> do kruhu asi 40 % broků, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/improved-cylinder/\"><span lang=\"en\">improved cylinder</span> (čtvrtinové zahrdlení)</a> asi 50 %, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/modified/\"><span lang=\"en\">modified</span> (půlčok)</a> asi 60 %, <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/improved-modified/\"><span lang=\"en\">improved modified</span> (tříčtvrtinové zahrdlení)</a> asi 65 % a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/full-choke/\"><span lang=\"en\">full choke</span> (plné zahrdlení)</a> 70 % i víc. Čísla závisí na náboji, takže vaše kombinace zbraně a náboje může dát jiný výsledek.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p4","t":"tip","html":"Jeden výstřel moc neukáže: zásahy se citelně liší i se stejnými náboji. Vystřelte na každou kombinaci aspoň 3–5 ran. Všímejte si i rovnoměrnosti: dobrý zásah je rovnoměrný, bez velkých „děr“ a bez husté skvrny uprostřed.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p5","t":"steps","html":["Po střelbě vyšroubujte zahrdlení <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/choke-key/\"><span lang=\"en\">choke key</span> (klíčem na zahrdlení)</a>.","Vyčistěte je zevnitř i zvenčí čisticím prostředkem a kartáčkem a otřete závit v ústí.","Než je zašroubujete zpět, naneste na závit tenkou vrstvu <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/choke-grease/\"><span lang=\"en\">choke grease</span> (tuku na zahrdlení)</a>: chrání před rzí a brání zahrdlení „přikipnout“."],"disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p6","t":"p","html":"Před každým tréninkem zkontrolujte, zda jsou zahrdlení dotažená, protože se střelbou se mohou pomalu povolovat. Zašroubujte je klíčem až na doraz, ale bez přílišné síly.","disc":null,"rule_ref":null},{"k":"chokes-pattern-testing-and-care-p7","t":"warn","html":"Nikdy nestřílejte ze zbraně s <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/multichoke/\"><span lang=\"en\">multichoke</span> (výměnným zahrdlením)</a> bez zahrdlení nebo s napůl zašroubovaným zahrdlením. Broky a <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/wad/\"><span lang=\"en\">wad</span> (kontejner)</a> mohou poškodit závit v ústí a oprava bude drahá. Náhradní zahrdlení uchovávejte ve zvláštním pouzdře, abyste je neztratili.","disc":null,"rule_ref":null}],"notes":[],"phrases":[],"key_points":[{"k":"chokes-pattern-testing-and-care-kp1","html":"Zásah se ověřuje na desce: přizpůsobení z přibližně 15 m (16 yardů), zahrdlení z 35 m nebo 40 yardů.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp2","html":"Počítejte podíl broků v kruhu 75–76 cm; vystřelte 3–5 ran.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp3","html":"Zahrdlení čistěte po střelbě a závity mažte tukem na zahrdlení.","checklist":false},{"k":"chokes-pattern-testing-and-care-kp4","html":"Před každým tréninkem zkontrolujte dotažení zahrdlení.","checklist":true},{"k":"chokes-pattern-testing-and-care-kp5","html":"Ze zbraně s výměnným zahrdlením se nestřílí bez zahrdlení.","checklist":false}],"did_you_know":{"k":"chokes-pattern-testing-and-care-dyk","html":"Po každém výstřelu se nástřelná deska znovu natře nebo namaže – válečkem nebo štětcem –, aby se nové stopy nesmíchaly s předchozími."},"quiz":[{"k":"chokes-pattern-testing-and-care-q1","q":"Proč nemáte střílet ze zbraně s multichoke (výměnným zahrdlením) bez zahrdlení?","options":[{"k":"a","text":"Je to zakázané jen na závodech"},{"k":"b","text":"Broky a kontejner mohou poškodit závit v ústí"},{"k":"c","text":"Zbraň pak vůbec nevystřelí"},{"k":"d","text":"Zásah se stane příliš hustým"}],"correct":"b","explain":"Bez zahrdlení je závit odkrytý a broky s kontejnerem ho mohou poškodit."},{"k":"chokes-pattern-testing-and-care-q2","q":"Na jaké klasické vzdálenosti se posuzuje zásah choke (zahrdlení)?","options":[{"k":"a","text":"5 m (asi 5½ yardu)"},{"k":"b","text":"15 m (asi 16 yardů)"},{"k":"c","text":"35 m nebo 40 yardů (asi 37 m)"},{"k":"d","text":"80 m (asi 87 yardů)"}],"correct":"c","explain":"Podíl broků v kruhu 75–76 cm se klasicky počítá na 35 m nebo 40 yardech."},{"k":"chokes-pattern-testing-and-care-q3","q":"Kolik výstřelů byste měli udělat, abyste posoudili zásah?","options":[{"k":"a","text":"Aspoň 3–5 na každou kombinaci"},{"k":"b","text":"Na to stačí jeden výstřel"},{"k":"c","text":"Přesně dva, po jednom na hlaveň"},{"k":"d","text":"Sto, a to ve stejný den"}],"correct":"a","explain":"Zásahy se liší výstřel od výstřelu, proto potřebujete sérii pro každou kombinaci zbraně, choke (zahrdlení) a náboje."}],"terms":[{"id":"pattern-plate","en":"Pattern plate","local":"nástřelná deska","label":"Pattern plate (nástřelná deska)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/pattern-plate/"},{"id":"pattern","en":"Pattern","local":"obrazec zásahu","label":"Pattern (obrazec zásahu)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/pattern/"},{"id":"choke","en":"Choke","local":"zahrdlení","label":"Choke (zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/choke/"},{"id":"multichoke","en":"Multichoke","local":"výměnné zahrdlení","label":"Multichoke (výměnné zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/multichoke/"},{"id":"choke-key","en":"Choke key","local":"klíč na zahrdlení","label":"Choke key (klíč na zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/choke-key/"},{"id":"choke-grease","en":"Choke grease","local":"tuk na zahrdlení","label":"Choke grease (tuk na zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/choke-grease/"},{"id":"gun-fit","en":"Gun fit","local":"přizpůsobení pažby","label":"Gun fit (přizpůsobení pažby)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/gun-fit/"},{"id":"wad","en":"Wad","local":"kontejner","label":"Wad (kontejner)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/wad/"},{"id":"cylinder","en":"Cylinder","local":"válec","label":"Cylinder (válec)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/cylinder/"},{"id":"improved-cylinder","en":"Improved cylinder","local":"čtvrtinové zahrdlení","label":"Improved cylinder (čtvrtinové zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/improved-cylinder/"},{"id":"modified","en":"Modified","local":"poloviční zahrdlení","label":"Modified (poloviční zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/modified/"},{"id":"improved-modified","en":"Improved modified","local":"tříčtvrtinové zahrdlení","label":"Improved modified (tříčtvrtinové zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/improved-modified/"},{"id":"full-choke","en":"Full choke","local":"plné zahrdlení","label":"Full choke (plné zahrdlení)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/full-choke/"}],"rule_refs":[],"sources":[{"title":"Trulock Chokes — choke constrictions and lead pattern percentages in a 30-inch circle at 40 yards","url":"https://trulockchokes.com/basic_choke_information.html","fitasc":false},{"title":"Briley — Understanding chokes: 12-gauge constriction chart (inches)","url":"https://www.briley.com/c-456-understanding-chokes.aspx","fitasc":false},{"title":"Shooting UK — Why you should always pattern your shotgun (pattern plate at 16 yards to check gun fit)","url":"https://www.shootinguk.co.uk/answers/why-you-should-always-pattern-your-shotgun-16881/","fitasc":false}],"evidence":[],"more_in_en":0}
