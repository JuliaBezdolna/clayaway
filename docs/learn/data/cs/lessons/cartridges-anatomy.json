circle class=\"dg-c6\" cx=\"341\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"155\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"174.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"282\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"293.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"305.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"317.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"329.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"341\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"352.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"364.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"376.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"388.2\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"400\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"411.8\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"423.6\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"435.4\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"447.20000000000005\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"459\" cy=\"194\" r=\"5\"/><circle class=\"dg-c6\" cx=\"287\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"298.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"310.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"322.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"334.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"346\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"357.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"369.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"381.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"393.2\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"405\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"416.8\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"428.6\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"440.4\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"452.20000000000005\" cy=\"213.5\" r=\"5\"/><circle class=\"dg-c6\" cx=\"464\" cy=\"213.5\" r=\"5\"/>\n<path class=\"dg-c7\" d=\"M468 104 L530 165 L468 226 M498 104 L530 165 L498 226 M528 104 L530 165 L528 226\"/>\n<g class=\"dg-dm\"><path d=\"M58 272v18M536 272v18M58 282h478\"/><text x=\"297\" y=\"306\" text-anchor=\"middle\">vystřelená nábojnice: obvykle 65–70 mm</text></g><g class=\"dg-n\"><circle cx=\"360\" cy=\"98\" r=\"14\"/><text x=\"360\" y=\"98\" text-anchor=\"middle\" dominant-baseline=\"central\">1</text></g><g class=\"dg-n\"><circle cx=\"70\" cy=\"92\" r=\"14\"/><text x=\"70\" y=\"92\" text-anchor=\"middle\" dominant-baseline=\"central\">2</text></g><g class=\"dg-n\"><circle cx=\"71\" cy=\"165\" r=\"14\"/><text x=\"71\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">3</text></g><g class=\"dg-n\"><circle cx=\"185\" cy=\"120\" r=\"14\"/><text x=\"185\" y=\"120\" text-anchor=\"middle\" dominant-baseline=\"central\">4</text></g><g class=\"dg-n\"><circle cx=\"245\" cy=\"216\" r=\"14\"/><text x=\"245\" y=\"216\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text></g><g class=\"dg-n\"><circle cx=\"400\" cy=\"150\" r=\"14\"/><text x=\"400\" y=\"150\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text></g><g class=\"dg-n\"><circle cx=\"515\" cy=\"165\" r=\"14\"/><text x=\"515\" y=\"165\" text-anchor=\"middle\" dominant-baseline=\"central\">7</text></g></svg><ol class=\"dg-leg\"><li><b aria-hidden=\"true\">1</b>Nábojnice (plastová nebo papírová)</li><li><b aria-hidden=\"true\">2</b>Kovová hlava</li><li><b aria-hidden=\"true\">3</b>Zápalka</li><li><b aria-hidden=\"true\">4</b>Prach</li><li><b aria-hidden=\"true\">5</b>Kontejner</li><li><b aria-hidden=\"true\">6</b>Broky</li><li><b aria-hidden=\"true\">7</b>Zálisek (hvězdička se 6 nebo 8 záhyby)</li></ol><figcaption>Co je uvnitř jednoho náboje, od kovové hlavy po zálisek.</figcaption></figure>","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p2","t":"p","html":"Nábojnice je trubička, nejčastěji plastová, s kovovou hlavicí dole. Existují i papírové nábojnice, a některé střelnice je upřednostňují, protože méně zanáší přírodu. Vystřelená nábojnice bývá dlouhá 65–70 mm a musí sedět do <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/chamber/\"><span lang=\"en\">chamber</span> (nábojové komory)</a> vaší zbraně (viz <a href=\"https://juliabezdolna.github.io/clayaway/cs/learn/gun-gauge-and-barrels/\">Ráže a délka hlavní</a>).","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p3","t":"p","html":"Uprostřed hlavice je zápalka. Když do ní udeří úderník, zápalka vydá jiskru a zapálí prach. Prach neexploduje, ale velmi rychle hoří, a plyny tlačí <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/load-weight/\"><span lang=\"en\">load weight</span> (náplň)</a> broků hlavní vpřed.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p4","t":"p","html":"Mezi prachem a broky je kontejner. Funguje jako zátka: nepouští horké plyny kolem broků, tlumí náraz a drží broky pohromadě, dokud letí hlavní. Plastový kontejner má obvykle „kalíšek“, který broky chrání a často dává trochu hustší zásah.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p8","t":"p","html":"<a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/fibre-wad/\"><span lang=\"en\">Fibre wad</span> (vláknitý nebo plstěný kontejner)</a> se v přírodě rozkládá, proto na něm mnohé střelnice trvají. Existují i biologicky rozložitelné plastové kontejnery, ale některé střelnice je neuznávají.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p5","t":"p","html":"Nad kontejnerem jsou broky: několik set malých kuliček. Horní okraj nábojnice uzavírá <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/crimp/\"><span lang=\"en\">crimp</span> (zálisek)</a>, nejčastěji „hvězdička“ se 6 nebo 8 záhyby. Dobrý zálisek pevně drží vše na místě a pomáhá, aby každý náboj vystřelil stejně jako ten předchozí.","disc":null,"rule_ref":null},{"k":"cartridges-anatomy-p6","t":"p","html":"Pravidla FITASC pro Parcours de Chasse – Sporting™ a Compak® Sporting zakazují <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/reloaded-cartridge/\"><span lang=\"en\">reloaded cartridge</span> (přebíjené náboje)</a>, tedy vystřelené nábojnice znovu naplněné, například doma. Zakázané jsou i rozptylovače (vložky, které schválně rozptylují broky víc) a jakékoli jiné zvláštní zařízení uvnitř náboje. Stejně tak nejsou dovolené smíšené broky různých velikostí nebo kvality, černý prach a trasery (náboje, které zanechávají světelnou stopu). Na závody tedy berte tovární náboje, které splňují pravidla.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p7","t":"tip","html":"Na krabičce bývá uvedena ráže, délka nábojnice, náplň, číslo nebo <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/shot-size/\"><span lang=\"en\">shot size</span> (průměr broků)</a>, materiál broků a typ kontejneru, často i rychlost. Naučte se číst krabičku a budete vědět, čím nabíjíte.","disc":null,"rule_ref":null},{"k":"gear-cartridges-p5","t":"p","html":"Některé střelnice mají vlastní ekologická pravidla pro trénink, například jen vláknité kontejnery nebo jen <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/steel-shot/\"><span lang=\"en\">steel shot</span> (ocelové broky)</a>: ověřte si pravidla střelnice před cestou. Prázdné nábojnice patří do koše na stanovišti a střelci se <a class=\"term\" href=\"https://juliabezdolna.github.io/clayaway/cs/glossary/semi-automatic/\"><span lang=\"en\">semi-automatic</span> (samonabíjecími brokovnicemi)</a> při odchodu sbírají své vystřelené nábojnice.","disc":"both","rule_ref":null},{"k":"cartridges-anatomy-p9","t":"p","html":"Tři čísla na krabičce mají vlastní lekce: ráže (<a href=\"https://juliabezdolna.github.io/clayaway/cs/learn/gun-gauge-and-barrels/\">Ráže a délka hlavní</a>), velikost broků (<a href=\"https://juliabezdolna.github.io/clayaway/cs/learn/cartridges-shot-size/\">Velikost broků</a>) a náplň (<a href=\"https://juliabezdolna.github.io/clayaway/cs/learn/cartridges-load-weight/\">Náplň broků</a>).","disc":null,"rule_ref":null}],"notes":[],"phrases":[{"k":"gear-cartridges-ph3","speaker":"coach","en":"Empties in the bin, please, not on the grass.","meaning":"Dávejte vystřelené nábojnice do koše.","say":"Nábojnice do koše, prosím, ne do trávy.","audio":1},{"k":"gear-cartridges-ph4","speaker":"coach","en":"Steel only on this ground.","meaning":"Lead shot (olovo) je na této střelnici zakázané (místní pravidlo, ne FITASC).","say":"Na této střelnici jen ocelové broky.","audio":1}],"key_points":[{"k":"gear-cartridges-kp1","html":"Náboj = nábojnice, zápalka, prach, kontejner, broky.","checklist":false},{"k":"cartridges-anatomy-kp2","html":"Plastový kontejner: často o trochu hustší zásah; vláknitý kontejner: rozkládá se v přírodě.","checklist":false},{"k":"cartridges-anatomy-kp4","html":"FITASC zakazuje přebíjené náboje, rozptylovače, smíšené broky, černý prach a trasery.","checklist":false},{"k":"cartridges-anatomy-kp5","html":"Čtěte krabičku: ráže, délka, náplň, broky, kontejner.","checklist":false},{"k":"gear-cartridges-kp5","html":"Vystřelené nábojnice patří do koše; majitelé samonabíjecích brokovnic sbírají své nábojnice.","checklist":false}],"did_you_know":{"k":"cartridges-anatomy-dyk","html":"Po výstřelu letí plastový kontejner ještě několik desítek metrů za stanoviště. Proto bývají pole kolem starých střelnic plné kontejnerů, zatímco vlákno se postupně rozkládá."},"quiz":[{"k":"cartridges-anatomy-q1","q":"Co zapálí powder (prach) v náboji?","options":[{"k":"a","text":"Kontejner"},{"k":"b","text":"Zápalka"},{"k":"c","text":"Zálisek"},{"k":"d","text":"Broky"}],"correct":"b","explain":"Úderník udeří do zápalky a ta zapálí prach."},{"k":"cartridges-anatomy-q2","q":"Proč mnohé střelnice vyžadují vláknité kontejnery?","options":[{"k":"a","text":"Jsou levnější"},{"k":"b","text":"Dávají hustší zásah"},{"k":"c","text":"Rozkládají se v přírodě"},{"k":"d","text":"Vyžaduje to FITASC"}],"correct":"c","explain":"Vlákno a plsť se rozkládají, zatímco běžné plastové kontejnery zůstávají na polích roky."},{"k":"cartridges-anatomy-q3","q":"Které cartridge (náboje) zakazují pravidla FITASC?","options":[{"k":"a","text":"Tovární s plastovým kontejnerem"},{"k":"b","text":"Tovární s vláknitým kontejnerem"},{"k":"c","text":"Náboje s papírovou nábojnicí"},{"k":"d","text":"Přebíjené náboje"}],"correct":"d","explain":"Přebíjené náboje, rozptylovače, smíšené broky, černý prach a trasery jsou zakázané.","rule_ref":"sporting:ch7-cartridges","disc":"both"}],"terms":[{"id":"cartridge","en":"Cartridge","local":"náboj","label":"Cartridge (náboj)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/cartridge/"},{"id":"hull","en":"Hull","local":"nábojnice","label":"Hull (nábojnice)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/hull/"},{"id":"primer","en":"Primer","local":"zápalka","label":"Primer (zápalka)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/primer/"},{"id":"powder","en":"Powder","local":"prach","label":"Powder (prach)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/powder/"},{"id":"wad","en":"Wad","local":"kontejner","label":"Wad (kontejner)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/wad/"},{"id":"fibre-wad","en":"Fibre wad","local":"plstěná ucpávka","label":"Fibre wad (plstěná ucpávka)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/fibre-wad/"},{"id":"crimp","en":"Crimp","local":"zálisek","label":"Crimp (zálisek)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/crimp/"},{"id":"chamber","en":"Chamber","local":"nábojová komora","label":"Chamber (nábojová komora)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/chamber/"},{"id":"empties","en":"Empty cases","local":"prázdné nábojnice","label":"Empty cases (prázdné nábojnice)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/empties/"},{"id":"semi-automatic","en":"Semi-automatic","local":"samonabíjecí brokovnice","label":"Semi-automatic (samonabíjecí brokovnice)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/semi-automatic/"},{"id":"steel-shot","en":"Steel shot","local":"ocelové broky","label":"Steel shot (ocelové broky)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/steel-shot/"},{"id":"shot-size","en":"Shot size","local":"velikost broků","label":"Shot size (velikost broků)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/shot-size/"},{"id":"load-weight","en":"Load weight","local":"broková náplň","label":"Load weight (broková náplň)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/load-weight/"},{"id":"gauge","en":"Gauge","local":"ráže","label":"Gauge (ráže)","url":"https://juliabezdolna.github.io/clayaway/cs/glossary/gauge/"}],"rule_refs":[{"book":"sporting","id":"ch7-cartridges","label":"Kapitola 7","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/weapons-and-ammunition/?lang=cs#ch7-cartridges"},{"book":"compak","id":"ch18-cartridge-bans","label":"Kapitola 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=cs#ch18-cartridge-bans"},{"book":"sporting","id":"ch8-turning-empties","label":"Kapitola 8","url":"https://juliabezdolna.github.io/clayaway/rules/en/sporting/rules-of-conduct-safety/?lang=cs#ch8-turning-empties"},{"book":"compak","id":"ch18-empty-cases","label":"Kapitola 18","url":"https://juliabezdolna.github.io/clayaway/rules/en/compak/shooting-equipment/?lang=cs#ch18-empty-cases"}],"sources":[{"title":"FITASC — official rules of Parcours de Chasse – Sporting™ and Compak® Sporting","url":"https://www.fitasc.com/disciplines-sportives/reglements-sportifs","fitasc":true},{"title":"C.I.P. — tables of dimensions of cartridges and chambers (TDCC), including shot cartridges","url":"https://www.cip-bobp.org/en/tdcc","fitasc":false}],"evidence":[],"more_in_en":0}
